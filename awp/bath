        color_preview.setFixedSize(23, 23)
        color_preview.setStyleSheet("background-color: #888; border: 1px solid #555; border-radius: 4px;")
        color_preview.setToolTip("Theme accent color")
        row.addWidget(color_preview)
        
        # Store reference to update later
        combo.color_preview = color_preview
        
        # Connect signal to update color when selection changes
        combo.currentTextChanged.connect(lambda: self.update_theme_color(combo))
        
        row.addStretch()
        return row
    
    def update_theme_color(self, combo):
        """Update the color preview for a combo when selection changes."""
        theme_name = combo.currentText()
        color = extract_color_from_theme(theme_name)
        
        if hasattr(combo, 'color_preview'):
            if color:
                combo.color_preview.setStyleSheet(f"""
                    background-color: {color}; 
                    border: 2px solid {color}; 
                    border-radius: 4px;
                """)
                combo.color_preview.setToolTip(f"Color: {color}")
            else:
                combo.color_preview.setStyleSheet("""
                    background-color: #888; 
                    border: 1px solid #555; 
                    border-radius: 4px;
                """)
                combo.color_preview.setToolTip("No color detected")
    
    def get_current_workspace(self):
