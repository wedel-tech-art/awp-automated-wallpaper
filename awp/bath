    def generate_themes(self):
        """Generate themes using core.themes."""
        hex_color = self.color_edit.text().strip()
        if not hex_color.startswith('#') or len(hex_color) != 7:
            QMessageBox.warning(self, "Error", "Please enter a valid hex color (e.g., #b7004f)")
            return
        
        gtk = self.gtk_combo.currentData()
        icon = self.icon_combo.currentData()
        cursor = self.cursor_combo.currentData()
        template = self.template_combo.currentData()
        
        try:
            icon_path = generate_icon_from_svg(hex_color, template)
            if not icon_path:
                QMessageBox.warning(self, "Error", "Failed to generate icon. Is rsvg-convert installed?")
                return
            
            # Bake themes using core.themes
            bake_awp_theme(hex_color, icon_path, gtk)
            bake_awp_icon(hex_color, icon_path, icon)
            bake_awp_cursor(hex_color, icon_path, cursor)
            
            cleanup_temp_icon(icon_path)
            
            self.populate_theme_lists()  # Refresh theme lists
            
            QMessageBox.information(self, "Success", f"Themes generated successfully!\n\nGTK: {gtk}\nIcon: {icon}\nCursor: {cursor}")
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to generate themes:\n\n{str(e)}")
    
    def apply_themes(self):
        """Apply themes using core.actions.set_themes()."""
        gtk = self.apply_gtk_combo.currentText()
        icon = self.apply_icon_combo.currentText()
        cursor = self.apply_cursor_combo.currentText()
        window = self.apply_window_combo.currentText() if self.caps.get('has_wm_theme', False) else ""
        desktop = self.apply_desktop_combo.currentText() if self.caps.get('has_desktop_theme', False) else ""
        
        # Build theme config
        theme_config = {}
        if gtk and gtk != "(Default)":
            theme_config['gtk_theme'] = gtk
        if icon and icon != "(Default)":
            theme_config['icon_theme'] = icon
        if cursor and cursor != "(Default)":
            theme_config['cursor_theme'] = cursor
        if window and window != "(Default)":
            theme_config['wm_theme'] = window
        if desktop and desktop != "(Default)":
            theme_config['desktop_theme'] = desktop
        
        if not theme_config:
            QMessageBox.warning(self, "Warning", "Please select at least one theme to apply.")
            return
        
        try:
            # Create fake config
            fake_config = SimpleConfig(theme_config)
            
            # Get current workspace
            ws_num = self.get_current_workspace()
            
            # Apply themes
            set_themes(ws_num, fake_config)
            
            QMessageBox.information(self, "Success", "Themes applied successfully!")
            
        except Exception as e:
            QMessageBox.critical(self, "Error", f"Failed to apply themes:\n\n{str(e)}")    
    
    def apply_all(self):
        # Apply wallpaper
        folder = self.folder_edit.text()
        if folder and os.path.exists(folder):
            from core.utils import load_images, sort_images
            images = load_images(folder)
            if images:
                sorted_images = sort_images(images, 'name_az')
                first_image = str(sorted_images[0])  # ← Pass the actual image!
                scaling = self.style_combo.currentText().lower()
                ws_num = self.get_current_workspace()
                set_wallpaper(ws_num, first_image, scaling)
                _printer.info(f"Applied wallpaper: {first_image}", backend="bath")
            else:
                _printer.warning(f"No images found in {folder}", backend="bath")
        
        # Apply themes (using the same logic as apply_themes)
        gtk = self.apply_gtk_combo.currentText()
        icon = self.apply_icon_combo.currentText()
        cursor = self.apply_cursor_combo.currentText()
        window = self.apply_window_combo.currentText() if self.caps.get('has_wm_theme', False) else ""
        desktop = self.apply_desktop_combo.currentText() if self.caps.get('has_desktop_theme', False) else ""
        
        theme_config = {}
        if gtk and gtk != "(Default)":
            theme_config['gtk_theme'] = gtk
        if icon and icon != "(Default)":
            theme_config['icon_theme'] = icon
        if cursor and cursor != "(Default)":
            theme_config['cursor_theme'] = cursor
        if window and window != "(Default)":
            theme_config['wm_theme'] = window
        if desktop and desktop != "(Default)":
            theme_config['desktop_theme'] = desktop
        
        if theme_config:
            fake_config = SimpleConfig(theme_config)
            ws_num = self.get_current_workspace()
            set_themes(ws_num, fake_config)
            _printer.info("Applied themes", backend="bath")
        
        # Apply blanking
        blanking_text = self.blanking_combo.currentText()
        if blanking_text == "Disabled":
            x11_blanking(0)
        else:
            try:
                value = int(blanking_text[:-1])
                unit = blanking_text[-1]
                if unit == 'm':
                    value *= 60
                elif unit == 'h':
                    value *= 3600
                x11_blanking(value)
            except:
                x11_blanking(1800)
        
        QMessageBox.information(self, "Success", "All settings applied successfully!")    
    
