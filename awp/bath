    def render_existing_icon_preview(self, theme_name, size=60):
        """
        Render the folder.svg from an already-baked icon theme.
        Trims transparent borders and centers the result.
        """
        import shutil
        
        if not theme_name or not theme_name.startswith('awp-icons-'):
            return None
        
        # Find the folder.svg in the baked icon theme
        svg_path = os.path.expanduser(f"~/.icons/{theme_name}/places/scalable/folder.svg")
        if not os.path.exists(svg_path):
            return None
        
        # Check if rsvg-convert is available
        if not shutil.which('rsvg-convert'):
            return None
        
        # Render with rsvg-convert at larger size for quality
        render_size = size * 3
        temp_dir = f"/dev/shm/awp_preview_{os.getpid()}"
        os.makedirs(temp_dir, exist_ok=True)
        
        temp_png = os.path.join(temp_dir, 'preview.png')
        trimmed_png = os.path.join(temp_dir, 'trimmed.png')
        
        try:
            # Step 1: Render SVG to PNG
            subprocess.run([
                'rsvg-convert',
                '-w', str(render_size),
                '-h', str(render_size),
                '-o', temp_png,
                svg_path
            ], check=True, capture_output=True, timeout=2)
            
            if not os.path.exists(temp_png):
                shutil.rmtree(temp_dir, ignore_errors=True)
                return None
            
            # Step 2: Trim transparent borders and center with ImageMagick
            if shutil.which('convert'):
                # Trim transparent borders
                subprocess.run([
                    'convert', temp_png,
                    '-trim', '+repage',  # Remove transparent borders
                    '-background', 'none',
                    '-gravity', 'center',
                    '-extent', f'{render_size}x{render_size}',  # Center in square
                    trimmed_png
                ], check=True, capture_output=True, timeout=2)
                
                # Step 3: Resize to final size
                subprocess.run([
                    'convert', trimmed_png,
                    '-resize', f'{size}x{size}',
                    '-background', 'none',
                    '-gravity', 'center',
                    '-extent', f'{size}x{size}',
                    temp_png  # Overwrite with final version
                ], check=True, capture_output=True, timeout=2)
            else:
                # No ImageMagick, just use the raw PNG (may not be centered)
                pass
            
            # Load the final image
            from PyQt6.QtGui import QPixmap
            pix = QPixmap(temp_png)
            shutil.rmtree(temp_dir, ignore_errors=True)
            return pix
            
        except Exception:
            shutil.rmtree(temp_dir, ignore_errors=True)
            return None
        
        return None
    
    def update_apply_icon_preview(self):
        """Update the floating preview for the Apply section's icon theme."""
        # Safety check: make sure the preview exists
        if not hasattr(self, 'apply_icon_preview'):
            return
        
        theme_name = self.apply_icon_combo.currentText()
        
        if not theme_name or not theme_name.startswith('awp-icons-'):
            self.apply_icon_preview.clear()
            self.apply_icon_preview.setText("🎨")
            return
        
        # Render the already-baked icon
        pix = self.render_existing_icon_preview(theme_name, 100)
        if pix and not pix.isNull():
            self.apply_icon_preview.setPixmap(pix)
            self.apply_icon_preview.setText("")
            self.apply_icon_preview.setToolTip(f"Icon preview: {theme_name}")
        else:
            self.apply_icon_preview.clear()
            self.apply_icon_preview.setText("🎨")
            self.apply_icon_preview.setToolTip("No preview available")   
    
