    def detect_de(self):
        """Enhanced DE detection matching backends/__init__.py logic."""
        import subprocess
        
        xdg_de = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
        desktop_session = os.environ.get("DESKTOP_SESSION", "").lower()
        wayland_display = os.environ.get("WAYLAND_DISPLAY", "")
        is_wayland = bool(wayland_display)
        
        def process_exists(name):
            try:
                output = subprocess.check_output(['pgrep', '-x', name], stderr=subprocess.DEVNULL)
                return bool(output.strip())
            except:
                return False
        
        def check_qtile():
            """Check if Qtile is running."""
            try:
                output = subprocess.check_output(['pgrep', '-x', 'qtile'], stderr=subprocess.DEVNULL)
                return bool(output.strip())
            except:
                return False
        
        has_xfsettingsd = process_exists('xfsettingsd')
        has_gsd_xsettings = process_exists('gsd-xsettings')
        has_qtile = check_qtile()
        
        de = "generic"
        
        # Qtile detection - check process first
        if has_qtile:
            if is_wayland:
                de = "qtile_wayland"
            elif has_gsd_xsettings:
                de = "qtile_gnome"
            elif has_xfsettingsd:
                de = "qtile_xfce"
            else:
                de = "qtile_xfce"  # Default Qtile
        elif 'qtile' in xdg_de or 'qtile' in desktop_session:
            if is_wayland:
                de = "qtile_wayland"
            elif has_gsd_xsettings:
                de = "qtile_gnome"
            elif has_xfsettingsd:
                de = "qtile_xfce"
            else:
                de = "qtile_xfce"
        elif 'xfce' in xdg_de or 'xfce' in desktop_session or 'xubuntu' in xdg_de:
            de = "xfce"
        elif 'gnome' in xdg_de or 'gnome' in desktop_session or 'ubuntu' in xdg_de:
            de = "gnome"
        elif 'cinnamon' in xdg_de or 'cinnamon' in desktop_session:
            de = "cinnamon"
        elif 'mate' in xdg_de or 'mate' in desktop_session:
            de = "mate"
        elif 'kde' in xdg_de or 'plasma' in desktop_session:
            de = "kde"
        elif is_wayland:
            de = "wayland"
        
        return de, "wayland" if is_wayland else "x11"
    
    def detect_workspace_count(self):
        """Get workspace count from the backend."""
        func = get_backend_func("workspace_count")
        if func:
            try:
                count = func()
                if count and count > 0:
                    _printer.info(f"Workspace count: {count}", backend="bath")
                    return str(count)
            except Exception as e:
                _printer.warning(f"Failed to get workspace count: {e}", backend="bath")
        
        # Fallback to 4 (common default)
        _printer.info("Workspace count (default): 4", backend="bath")
        return "4"
    
    def create_standard_combo(self, items=None, width=160, default=None):
        combo = QComboBox()
        combo.setFixedWidth(width)
        combo.setEditable(True)
        combo.setInsertPolicy(QComboBox.InsertPolicy.NoInsert)
        combo.lineEdit().setReadOnly(True)
        combo.lineEdit().setAlignment(Qt.AlignmentFlag.AlignLeft)
        
        if items:
            for i, item in enumerate(items):
                if isinstance(item, tuple):
                    combo.addItem(item[0], item[1])
                    # If this item's display text matches the default, select it
                    if default and item[0] == default:
                        combo.setCurrentIndex(i)
                else:
                    combo.addItem(item, item)
                    if default and item == default:
                        combo.setCurrentIndex(i)
        
        return combo
    
    def create_label(self, text, width=120):
        """Create a standardized label with fixed width."""
        label = QLabel(text)
        label.setFixedWidth(width)
