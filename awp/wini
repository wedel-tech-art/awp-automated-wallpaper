    def on_workspace_count_changed(self):
        """Re-roll shuffle if active, and refresh the HUD."""
        if self.pending_shuffle is not None:
            self.pending_shuffle = roll_shuffle_plan(self.ws_combo.currentData())
        if getattr(self, 'hud_window', None):
            self.hud_window.update_from_state()
    
    def on_shuffle_toggled(self, checked):
        """Roll or release the shuffle plan, and refresh the HUD."""
        if checked:
            # Mutually exclusive with Use INI
            if self.ini_btn.isChecked():
                self.ini_btn.setChecked(False)   # triggers on_ini_toggled(False)
            self.ini_btn.setEnabled(False)

            self.pending_shuffle = roll_shuffle_plan(self.ws_combo.currentData())
            self.statusBar().showMessage("🎲 Shuffle ON - Colors will be randomized!")
            self.statusBar().setStyleSheet("color: #d4a017;")
        else:
            self.pending_shuffle = None
            self.statusBar().showMessage("Ready")
            self.statusBar().setStyleSheet("")

            # Re-enable Use INI if an active preset exists
            if self.active_preset:
                self.ini_btn.setEnabled(True)

        # Refresh the HUD if open
        if getattr(self, 'hud_window', None):
            self.hud_window.update_from_state()
    
    def on_ini_toggled(self, checked):
        """Handle the Use INI toggle."""
        if checked:
            # Save current combo state so we can restore it on toggle-off
            self._pre_ini_state = {
                "backend": self.backend_combo.currentData(),
                "os": self.os_combo.currentText(),
                "session": self.session_combo.currentText(),
                "workspaces": self.ws_combo.currentData(),
                "prefix": self.prefix_input.text(),
            }
            
            # Mutually exclusive with Shuffle
            if self.shuffle_btn.isChecked():
                self.shuffle_btn.setChecked(False)
            self.shuffle_btn.setEnabled(False)

            # Disable the config combos — they're sourced from the INI
            self.backend_combo.setEnabled(False)
            self.os_combo.setEnabled(False)
            self.session_combo.setEnabled(False)
            self.ws_combo.setEnabled(False)
            self.prefix_input.setEnabled(False)

            # Load the INI data
            ini_data = self._load_active_ini_data()
            if not ini_data:
                # Safety: couldn't read the INI — bail out, revert the toggle
                self.ini_btn.setChecked(False)   # triggers else branch
                QMessageBox.warning(
                    self, "INI Not Found",
                    f"Could not read the active preset's INI.\n\n"
                    f"Preset: {self.active_preset}"
                )
                return

            self.source_data = ini_data

            # Prefill the combos with the INI's values
            self._prefill_from_ini()

            _printer.debug(
                f"Loaded {len(ini_data['workspaces'])} workspaces from active INI",
                backend="wini",
            )

            self.statusBar().showMessage(f"📁 Source: active INI ({self.active_preset})")
            self.statusBar().setStyleSheet("color: #5aa8e0;")
        else:
            # Clear INI data
            self.source_data = None

            # Restore the pre-INI combo state (fall back to defaults if nothing saved)
            if self._pre_ini_state:
                self._restore_combo_state(self._pre_ini_state)
            else:
                self._reset_combos_to_defaults()
            self._pre_ini_state = None

            # Re-enable Shuffle
            self.shuffle_btn.setEnabled(True)

            # Re-enable the config fields
            self.backend_combo.setEnabled(True)
            self.os_combo.setEnabled(True)
            self.session_combo.setEnabled(True)
            self.ws_combo.setEnabled(True)
            self.prefix_input.setEnabled(True)

            self.statusBar().showMessage("Ready")
            self.statusBar().setStyleSheet("")

        # Refresh the HUD if open
        if getattr(self, 'hud_window', None):
            self.hud_window.update_from_state()
    
    def on_os_changed(self, os_name):
        """Sync the suffix label when OS selection changes."""
        if hasattr(self, 'suffix_label'):
            self.suffix_label.setText(f"-{os_name}")
        
    def on_style_changed(self):
        """Update the logo list when background changes, and update the preview."""
        bg_id = self.bg_combo.currentData()
        
        # Rebuild logo list to only show logos that work with this background
        self.logo_combo.blockSignals(True)
        current_logo = self.logo_combo.currentData()
        self.logo_combo.clear()
        
        # Sort logos alphabetically
        for logo_id in sorted(LOGO_POSITIONS.keys()):
            if bg_id in LOGO_POSITIONS[logo_id]:
                self.logo_combo.addItem(logo_id, logo_id)
        
        # Try to keep the previously selected logo if still valid
        if current_logo:
            idx = self.logo_combo.findData(current_logo)
            if idx >= 0:
                self.logo_combo.setCurrentIndex(idx)
        
        self.logo_combo.blockSignals(False)
        
        # Update preview
        self.update_style_preview()

    def update_style_preview(self):
        """Update the style preview label with the current combination."""
        bg_id = self.bg_combo.currentData()
        logo_id = self.logo_combo.currentData()
        
        if not bg_id:
            self.style_preview.setText("Select a background")
            return
        
        raw_accent = read_raw_accent()  # ← use raw, not derived
        bg_data = BACKGROUNDS.get(bg_id, {})
        
        if bg_data.get("no_logo"):
            style_id = bg_id
        elif logo_id:
            style_id = f"{logo_id}-{bg_id}"
        else:
            self.style_preview.setText("Select a logo")
            return
        
        if style_id in WALLPAPER_SVG_TEMPLATES:
            sample_filename = compute_wallpaper_name("#b7004f", style_id)
            self.style_preview.setText(f"→ {sample_filename}")
            self.style_preview.setStyleSheet(f"""
                QLabel {{
                    background: transparent;
                    color: {raw_accent};
                    border: none;
                    padding: 4px 1px;
                    font-size: 12px;
                    font-weight: bold;
                }}
            """)
            self.style_preview.setToolTip(
                "Resulting wallpaper filenames will follow this pattern.\n"
                "Format: <prefix>-<hue>-<hex>.png\n"
                "Each workspace gets its own hue/hex from its color."
            )
        else:
            self.style_preview.setText(f"→ {style_id} (unavailable)")
            self.style_preview.setStyleSheet("""
                QLabel {
                    background: transparent;
                    color: #d04040;
                    border: none;
                    padding: 4px 1px;
                    font-size: 12px;
                    font-weight: bold;
                }
            """)

    def get_selected_style_id(self) -> str:
        """Get the currently selected wallpaper style ID (e.g., 'awp-firma-cave')."""
        bg_id = self.bg_combo.currentData()
        logo_id = self.logo_combo.currentData()
        
        if not bg_id:
            return DEFAULT_WALLPAPER_TEMPLATE
        
        bg_data = BACKGROUNDS.get(bg_id, {})
        if bg_data.get("no_logo"):
            return bg_id
        
        if not logo_id:
            return DEFAULT_WALLPAPER_TEMPLATE
        
        return f"{logo_id}-{bg_id}"

    def _connect_hud_refresh(self):
        """Trigger a HUD re-render whenever a setting that affects preview changes."""
        if not getattr(self, 'hud_window', None):
            return
        self.backend_combo.currentIndexChanged.connect(self.hud_window.update_from_state)
        self.session_combo.currentIndexChanged.connect(self.hud_window.update_from_state)
        self.ws_combo.currentIndexChanged.connect(self.hud_window.update_from_state)
        self.bg_combo.currentIndexChanged.connect(self.hud_window.update_from_state)
        self.logo_combo.currentIndexChanged.connect(self.hud_window.update_from_state)

    def _disconnect_hud_refresh(self):
        """Break the signal links when the HUD is closed."""
        if not getattr(self, 'hud_window', None):
            return
        for sig in (
            self.backend_combo.currentIndexChanged,
            self.session_combo.currentIndexChanged,
            self.ws_combo.currentIndexChanged,
            self.bg_combo.currentIndexChanged,
            self.logo_combo.currentIndexChanged,
        ):
            try:
                sig.disconnect(self.hud_window.update_from_state)
            except TypeError:
                pass   # wasn't connected
    
    def toggle_hud(self, checked):
        """Open or close the preset preview HUD."""
        if checked:
            from hud_preset import PresetPreviewHUD
            self.hud_window = PresetPreviewHUD(self.get_preview_state)
            self.hud_window.show()
            # Refresh the HUD when any relevant combo changes
            self._connect_hud_refresh()
        else:
            if getattr(self, 'hud_window', None):
                self.hud_window.close()
                self.hud_window = None
            self._disconnect_hud_refresh()
    
    def closeEvent(self, event):
        """Close the HUD when Wini closes."""
        if getattr(self, 'hud_window', None):
            self.hud_window.close()
            self.hud_window = None
        super().closeEvent(event)
    
    def create_preset(self):
        """Create the preset."""
        backend = self.backend_combo.currentData()
        os_name = self.os_combo.currentText().strip().lower()
        session_type = self.session_combo.currentText()
        workspace_count = self.ws_combo.currentData()
        shuffle_enabled = self.shuffle_btn.isChecked()
        wallpaper_style = self.get_selected_style_id()

        # Validate the wallpaper combination
        if wallpaper_style not in WALLPAPER_SVG_TEMPLATES:
            QMessageBox.warning(self, "Unavailable Combination",
                f"This background + logo combination isn't available:\n\n"
                f"  {wallpaper_style}\n\n"
                f"Please pick a different combination.")
            return
        
        # Build preset name from prefix + suffix
        prefix = self.prefix_input.text().strip()
        suffix = self.suffix_label.text().strip().lstrip('-')
        
        if not prefix:
            QMessageBox.warning(self, "Validation Error", "Please enter a preset prefix.")
            return
        
        if not suffix:
            QMessageBox.warning(self, "Validation Error", "OS suffix not set.")
            return
        
        # Sanitize prefix
        prefix = re.sub(r'[^a-zA-Z0-9_-]', '', prefix)
        self.prefix_input.setText(prefix)
        
        preset_name = f"{prefix}-{suffix}"

        if not os_name:
            QMessageBox.warning(self, "Validation Error", "Please select or type an operating system name.")
            return
        
        preset_dir = self.presets_dir / preset_name
        if preset_dir.exists():
            is_active = (self.active_preset is not None
                         and preset_name == self.active_preset)

            if is_active:
                title = "Active Preset"
                message = (
                    f"'{preset_name}' is the currently ACTIVE preset.\n\n"
                    f"Overwriting will replace its INI and its wallpapers.\n"
                    f"If the AWP daemon is running, it will reload this preset.\n\n"
                    f"Your current wallpapers will be preserved in "
                    f"wallpapers.old/ — but the INI edits will NOT be preserved.\n\n"
                    f"Overwrite the active preset?"
                )
            else:
                title = "Preset Exists"
                message = f"Preset '{preset_name}' already exists.\n\nOverwrite?"

            reply = QMessageBox.question(
                self, title, message,
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No   # ← default to No
            )
            if reply != QMessageBox.StandardButton.Yes:
                return
        
        self.create_btn.setEnabled(False)
        self.create_btn.setText("⏳ Creating...")
        self.progress_bar.setVisible(True)
        self.progress_bar.setValue(0)
        self.statusBar().showMessage("Creating preset...")
        
        # Build source_workspaces from self.source_data when in INI mode
        source_workspaces = None
        if self.ini_btn.isChecked() and self.source_data:
            source_workspaces = {
                ws["section"]: ws
                for ws in self.source_data["workspaces"]
            }

        self.worker = PresetCreatorWorker(
            preset_name, backend, os_name, session_type, workspace_count,
            shuffle_enabled, wallpaper_style=wallpaper_style,
            shuffle_plan=self.pending_shuffle,
            source_workspaces=source_workspaces,
        )
        self.worker.progress.connect(self.update_progress)
        self.worker.finished.connect(self.creation_finished)
        self.worker.start()
    
    def update_progress(self, value: int, message: str):
        self.progress_bar.setValue(value)
        self.statusBar().showMessage(message)
        QApplication.processEvents()
    
    def creation_finished(self, success: bool, message: str):
        self.progress_bar.setVisible(False)
        self.create_btn.setEnabled(True)
        self.create_btn.setText("🧙 Create Preset")
        
        # Reset shuffle button state after creation
        if self.shuffle_btn.isChecked():
            self.shuffle_btn.setChecked(False)
            self.statusBar().setStyleSheet("")
        
        if success:
            self.statusBar().showMessage("Preset created successfully!")
            
            preset_name = f"{self.prefix_input.text().strip()}-{self.suffix_label.text().strip().lstrip('-')}"
            preset_dir = self.presets_dir / preset_name
            
            msg = f"✅ Preset '{preset_name}' created successfully!\n\n"
            msg += f"Location: {preset_dir}\n\n"
            msg += "📁 Wallpaper folders created:\n"
            msg += "\n".join([f"   - wallpapers/ws{i}/" for i in range(1, self.ws_combo.currentData() + 1)])
            
            if (preset_dir / "wallpapers.old").exists():
                msg += f"\n\n🛡️  Old wallpapers preserved in: wallpapers.old/"
                msg += f"\n   To recover: cp -r wallpapers.old/* wallpapers/"
                msg += f"\n   To delete: rm -rf wallpapers.old/"
            
            msg += "\n\nNext steps:\n"
            msg += "1. Run 'baker' to generate themes\n"
            msg += "2. Run 'awp_start.sh <preset_name>' to use it\n"
            msg += "3. Add wallpapers to the workspace folders"
            
            QMessageBox.information(self, "Preset Created", msg)
        else:
            self.statusBar().showMessage("Creation failed!")
            QMessageBox.critical(self, "Error", message)

