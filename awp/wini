    def on_style_changed(self):
        """Update the logo list when background changes, and update the preview."""
        bg_id = self.bg_combo.currentData()
        
        # Rebuild logo list to only show logos that work with this background
        self.logo_combo.blockSignals(True)
        current_logo = self.logo_combo.currentData()
        self.logo_combo.clear()
        
        # Sort logos alphabetically
        for logo_id in sorted(LOGO_POSITIONS.keys()):
            if bg_id in LOGO_POSITIONS[logo_id]:
                self.logo_combo.addItem(logo_id, logo_id)
        
        # Try to keep the previously selected logo if still valid
        if current_logo:
            idx = self.logo_combo.findData(current_logo)
            if idx >= 0:
                self.logo_combo.setCurrentIndex(idx)
        
        self.logo_combo.blockSignals(False)
        
        # Update preview
        self.update_style_preview()

    def update_style_preview(self):
        """Update the style preview label with the current combination."""
        bg_id = self.bg_combo.currentData()
        logo_id = self.logo_combo.currentData()
        
        if not bg_id:
            self.style_preview.setText("Select a background")
            return
        
        raw_accent = read_raw_accent()  # ← use raw, not derived
