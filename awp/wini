def _hue_deg(hex6: str) -> float:
    r, g, b = (int(hex6[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return colorsys.rgb_to_hsv(r, g, b)[0] * 360


def _hue_gap(a: float, b: float) -> float:
    d = abs(a - b) % 360
    return min(d, 360 - d)


def _weighted_choice(rng, items):
    """items: list of (value, weight>0). Returns one value."""
    total = sum(w for _, w in items)
    r = rng.uniform(0, total)
    acc = 0.0
    for value, w in items:
        acc += w
        if r <= acc:
            return value
    return items[-1][0]


def _roll_pairs(rng, n: int) -> list:
    """Pick n (gtk, icon) pairs using ICON_PROFILE / STYLE_GTK."""
    unused = list(ICON_PROFILE)
    uses = {g: 0 for g in GTK_PRIORITY}
    pairs = []

    def weight(icon, gtk):
        w = STYLE_GTK[ICON_PROFILE[icon]['style']].get(gtk, 0)
        return w / (1 + 2 * uses[gtk])          # soft penalty for repeats

    def take(icon, gtk):
        unused.remove(icon)
        uses[gtk] += 1
        pairs.append((gtk, icon))

    # A. Coverage: every GTK theme gets one slot (most restrictive first)
    for gtk in GTK_PRIORITY[:n]:
        cands = [(ic, weight(ic, gtk)) for ic in unused if weight(ic, gtk) > 0]
        if not cands:
            cands = [(ic, 1) for ic in unused]
        take(_weighted_choice(rng, cands), gtk)

    # B. Remaining workspaces: random unused icons, GTK picked by affinity
    rng.shuffle(unused)
    while len(pairs) < n:
        if not unused:   # more workspaces than icon sets: reuse office icons
            unused = [i for i, p in ICON_PROFILE.items() if p['style'] == 'office']
        icon = unused[0]
        style = ICON_PROFILE[icon]['style']
        # Extra workspaces only repeat the neutral themes; specialists stay unique
        cands = [(g, max(weight(icon, g), 0.5)) for g in ('breeze', 'mint-relax')]
        take(icon, _weighted_choice(rng, cands))

    return pairs


_LAB_CACHE = {}


def _lab(hex6: str):
    v = _LAB_CACHE.get(hex6)
    if v is None:
        r, g, b = (int(hex6[i:i + 2], 16) / 255 for i in (0, 2, 4))
        lin = lambda c: c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
        r, g, b = lin(r), lin(g), lin(b)
        x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047
        y = 0.2126 * r + 0.7152 * g + 0.0722 * b
        z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883
        f = lambda t: t ** (1 / 3) if t > 0.008856 else 7.787 * t + 16 / 116
        fx, fy, fz = f(x), f(y), f(z)
        v = (116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz))
        _LAB_CACHE[hex6] = v
    return v


def _color_distance(a: str, b: str) -> float:
    la, lb = _lab(a), _lab(b)
    return (((COLOR_L_WEIGHT * (la[0] - lb[0])) ** 2
             + (la[1] - lb[1]) ** 2 + (la[2] - lb[2]) ** 2) ** 0.5)


def _family_pool(family: str, needs: str) -> list:
    tiers = SHUFFLE_COLOR_FAMILIES[family]
    if needs == 'vivid':
        return tiers['vivid']
    if needs == 'medium':
        return tiers['medium']
    return tiers['vivid'] + tiers['medium']


def _color_score(cols: list):
    """(smallest pairwise distance, mean pairwise distance) - higher is better."""
    ds = [_color_distance(cols[i], cols[j])
          for i in range(len(cols)) for j in range(i + 1, len(cols))]
    return (min(ds), sum(ds) / len(ds)) if ds else (999.0, 999.0)


def _assign_families(rng, allowed: list, all_fams: list) -> list:
    """One family per workspace (distinct while families last), honouring `allowed`."""
    n = len(allowed)
    best = None

    for _ in range(50):
        order = list(range(n))
        rng.shuffle(order)
        order.sort(key=lambda i: len(allowed[i]))        # most restricted first

        fams = [None] * n
        used = set()
        relaxed_at = None

        for i in order:
            free = [f for f in allowed[i] if f not in used]
            if not free:
                # No unused family available for this workspace.
                # Relax here so the rest of the assignment can proceed,
                # but remember that this attempt wasn't perfect.
                if relaxed_at is None:
                    relaxed_at = i
                free = list(allowed[i])
            fams[i] = rng.choice(free)
            used.add(fams[i])

        if relaxed_at is None:
            return fams                                  # perfect — done

        if best is None:
            best = fams                                  # keep first relaxed as fallback

    return best if best is not None else [rng.choice(allowed[i]) for i in range(n)]


def _roll_colors(rng, needs: list, gtks: list) -> list:
    """
    One shade per workspace (same order as `needs` / `gtks`). Each workspace gets a
    different hue family (never one in GTK_AVOID_FAMILIES for its GTK theme) and a
    shade from the tier its icon needs, and the set is searched so that EVERY pair
    of workspaces is at least MIN_COLOR_DISTANCE apart (best effort if unreachable).
    """
    n = len(needs)
    all_fams = list(SHUFFLE_COLOR_FAMILIES)
    allowed = [[f for f in all_fams if f not in GTK_AVOID_FAMILIES.get(g, ())] for g in gtks]
    best = None
    for _ in range(60):
        fams = _assign_families(rng, allowed, all_fams)
        cols = [rng.choice(_family_pool(f, nd)) for f, nd in zip(fams, needs)]
        sc = _color_score(cols)
        for _ in range(60):
            if sc[0] >= MIN_COLOR_DISTANCE or n < 2:
                break
            # take the closest pair and re-roll one of its two shades (or swap families)
            i, j = min(((p, q) for p in range(n) for q in range(p + 1, n)),
                       key=lambda pq: _color_distance(cols[pq[0]], cols[pq[1]]))
            k = rng.choice((i, j))
            new_fams, new_cols = fams[:], cols[:]
            m = rng.choice([x for x in range(n) if x != k]) if n > 1 else k
            if n > 1 and rng.random() < 0.25 and fams[m] in allowed[k] and fams[k] in allowed[m]:
                new_fams[k], new_fams[m] = new_fams[m], new_fams[k]
                new_cols[k] = rng.choice(_family_pool(new_fams[k], needs[k]))
                new_cols[m] = rng.choice(_family_pool(new_fams[m], needs[m]))
            else:
                new_cols[k] = rng.choice(_family_pool(fams[k], needs[k]))
            new_sc = _color_score(new_cols)
            if new_sc >= sc:
                fams, cols, sc = new_fams, new_cols, new_sc
        if best is None or sc > best[0]:
            best = (sc, cols)
        if best[0][0] >= MIN_COLOR_DISTANCE or n < 2:
            break
    return best[1]


def _neighbor_cost(bundles: list) -> float:
    cost = 0.0
    for a, b in zip(bundles, bundles[1:]):
        gap = _hue_gap(a['hue'], b['hue'])
        if gap < MIN_NEIGHBOR_HUE_GAP:
            cost += (MIN_NEIGHBOR_HUE_GAP - gap) / MIN_NEIGHBOR_HUE_GAP
        if a['style'] in LOUD_STYLES and b['style'] in LOUD_STYLES:
            cost += 1.0
        if a['gtk'] == b['gtk']:
            cost += 0.5
    return cost


def roll_shuffle_plan(workspace_count: int = 8, seed=None) -> list:
    """
    Roll a shuffle plan. Returns a list of dicts, one per workspace,
    each containing:
        {
            "icon_color": "#xxxxxx",
            "gtk_theme": "awp-gtk-...-xxxxxx",
            "icon_theme": "awp-icons-...-xxxxxx",
            "cursor_theme": "awp-cursor-oxy-xxxxxx",
            "desktop_theme": "awp-gtk-...-xxxxxx",
            "wm_theme": "awp-gtk-...-xxxxxx",
            "mode": "sequential" | "random",
            "order": "name_az" | ...,
            "timing": "30s" | ...,
            "scaling": "zoomed" | "scaled",
        }

    How it works:
      1. GTK/icon pairs come from ICON_PROFILE + STYLE_GTK (affinity, not fixed pairs).
      2. Each workspace gets a different hue family (skipping the ones that clash with
         its GTK theme, see GTK_AVOID_FAMILIES); the shade tier (vivid/medium)
         is chosen by what the icon set needs, and the colours are searched so
         that ALL pairs of workspaces differ clearly (MIN_COLOR_DISTANCE).
      3. The finished bundles are re-ordered so neighbours differ in hue, loud
         icon styles don't touch, and the same GTK doesn't repeat back to back.

    Pure function: no I/O. Pass `seed` to reproduce a roll.
    """
    rng = random.Random(seed)
    n = max(1, workspace_count)

    # 1. Pairs
    pairs = _roll_pairs(rng, n)

    # 2. Colors: different family per workspace, shade tier by icon need,
    #    and every pair of workspaces clearly different (not just neighbours)
    needs = [ICON_PROFILE[icon]['needs'] for _, icon in pairs]
    shades = _roll_colors(rng, needs, [g for g, _ in pairs])
    bundles = []
    for (gtk, icon), color_hex in zip(pairs, shades):
        bundles.append({
            'gtk': gtk, 'icon': icon, 'color': color_hex,
            'hue': _hue_deg(color_hex), 'style': ICON_PROFILE[icon]['style'],
        })

    # 3. Order: best of many random permutations (stops early on a perfect one)
    best, best_cost = bundles[:], _neighbor_cost(bundles)
    for _ in range(400):
        if best_cost == 0:
            break
        trial = bundles[:]
        rng.shuffle(trial)
        c = _neighbor_cost(trial)
        if c < best_cost:
            best, best_cost = trial, c

    # 4. Build the plan
    plan = []
    for b in best:
        color_hex = b['color']
        gtk_theme = f"awp-gtk-{b['gtk']}-{color_hex}"
        mode = rng.choice(SHUFFLE_MODES)
        order = 'n' if mode == 'random' else rng.choice(SHUFFLE_ORDER_OPTIONS)

        plan.append({
            "icon_color": f"#{color_hex}",
            "gtk_theme": gtk_theme,
            "icon_theme": f"awp-icons-{b['icon']}-{color_hex}",
            "cursor_theme": f"awp-cursor-oxy-{color_hex}",
            "desktop_theme": gtk_theme,
            "wm_theme": gtk_theme,
            "mode": mode,
            "order": order,
            "timing": rng.choice(SHUFFLE_TIMINGS),
            "scaling": rng.choice(SHUFFLE_SCALINGS),
        })

    return plan


class PresetCreatorWorker(QThread):
    progress = pyqtSignal(int, str)
    finished = pyqtSignal(bool, str)
    
    def __init__(self, preset_name, backend, os_name, session_type, workspace_count,
                 shuffle_enabled=False, wallpaper_style=None, shuffle_plan=None,
                 source_workspaces=None):
        super().__init__()
        self.preset_name = preset_name
        self.backend = backend
        self.os = os_name
        self.session_type = session_type
        self.workspace_count = workspace_count
        self.shuffle_enabled = shuffle_enabled
        self.wallpaper_style = wallpaper_style or DEFAULT_WALLPAPER_TEMPLATE
        self.shuffle_plan = shuffle_plan
        self.source_workspaces = source_workspaces
        self.awp_dir = Path.home() / "awp"
        self.presets_dir = self.awp_dir / "presets"
        self.ws_source_dir = self.awp_dir / "ws"
        
    def generate_ini_content(self) -> str:
        lines = []
        home = str(Path.home())
        preset_dir_path = str(self.presets_dir / self.preset_name)
        
        lines.append("[general]")
        lines.append(f"os_detected = {self.backend}")
        lines.append(f"session_type = {self.session_type}")
        lines.append(f"workspaces = {self.workspace_count}")
        lines.append("")
        
        for i in range(1, self.workspace_count + 1):
            ws_name = f"ws{i}"
            lines.append(f"[{ws_name}]")

            # Look up the source workspace data if INI mode is active
            ws_source = None
            if self.source_workspaces and ws_name in self.source_workspaces:
                ws_source = self.source_workspaces[ws_name]

            # Folder — from source when available, else preset default
            if ws_source and ws_source.get("folder"):
                folder = ws_source["folder"]
            else:
                folder = f"{preset_dir_path}/wallpapers/{ws_name}"
            lines.append(f"folder = {folder}")

            # Icon — always Wini's default (fixed path)
            icon = f"{home}/awp/logos/ws{i}.png"
            lines.append(f"icon = {icon}")

            # [wsN] fields — from source (INI mode) or templates (default)
            if ws_source:
                # INI mode: write the source's values verbatim
                for key in ("icon_color", "timing", "mode", "order", "scaling",
                            "icon_theme", "gtk_theme", "cursor_theme",
                            "desktop_theme", "wm_theme"):
                    value = ws_source.get(key, "")
                    if value:
                        lines.append(f"{key} = {value}")
            elif ws_name in WORKSPACE_TEMPLATES:
                # Template mode: existing behavior
                ws_data = WORKSPACE_TEMPLATES[ws_name]
                for key, value in ws_data.items():
                    if "@COLOR@" in value:
                        color = ws_data.get("icon_color", "#000000").lstrip('#')
                        value = value.replace("@COLOR@", color)
                    lines.append(f"{key} = {value}")
            else:
                # Fallback (no template, no source)
                lines.append("icon_color = #666666")
                lines.append("timing = 5m")
                lines.append("mode = sequential")
                lines.append("order = name_az")
                lines.append("scaling = zoomed")

            lines.append("")
        
        return "\n".join(lines)
    
    def generate_ini_content_from_plan(self, plan: list) -> str:
        """
        Build INI text from a pre-rolled shuffle plan.
        Matches the structure of generate_ini_content(), but reads [wsN] values
        from the plan instead of WORKSPACE_TEMPLATES.
        """
        lines = []
        home = str(Path.home())
        preset_dir_path = str(self.presets_dir / self.preset_name)

        # [general] — identical to the template-based path
        lines.append("[general]")
        lines.append(f"os_detected = {self.backend}")
        lines.append(f"session_type = {self.session_type}")
        lines.append(f"workspaces = {self.workspace_count}")
        lines.append("")

        # [wsN] — from the plan
        for i in range(1, self.workspace_count + 1):
            ws_name = f"ws{i}"
            lines.append(f"[{ws_name}]")

            # Folder — from source when available, else preset default
            ws_source = None
            if self.source_workspaces and ws_name in self.source_workspaces:
                ws_source = self.source_workspaces[ws_name]

            if ws_source and ws_source.get("folder"):
                folder = ws_source["folder"]
            else:
                folder = f"{preset_dir_path}/wallpapers/{ws_name}"
            lines.append(f"folder = {folder}")

            icon = f"{home}/awp/logos/ws{i}.png"
            lines.append(f"icon = {icon}")

            if i - 1 < len(plan):
                ws_data = plan[i - 1]
            else:
                ws_data = WORKSPACE_TEMPLATES.get(ws_name, {})

            for key in ("icon_color", "timing", "mode", "order", "scaling",
                        "icon_theme", "gtk_theme", "cursor_theme",
                        "desktop_theme", "wm_theme"):
                value = ws_data.get(key, "")
                if value:
                    lines.append(f"{key} = {value}")

            lines.append("")

        return "\n".join(lines)
    
    def find_wallpaper(self, ws_num: int) -> Optional[Path]:
        """Find a wallpaper for a workspace, checking multiple extensions."""
        # Try new naming: wallpaper{N}.ext
        extensions = ['.png', '.jpg', '.jpeg', '.avif', '.webp', '.gif', '.bmp']
        for ext in extensions:
            candidate = self.ws_source_dir / f"wallpaper{ws_num}{ext}"
            if candidate.exists():
                return candidate
        
        # Fallback: try old naming (ws{N}.ext) for backward compatibility
        for ext in extensions:
            candidate = self.ws_source_dir / f"ws{ws_num}{ext}"
            if candidate.exists():
                return candidate
        
        return None
   
    def run(self):
        try:
            self.progress.emit(10, "Creating preset directory...")
            preset_dir = self.presets_dir / self.preset_name
            
            if preset_dir.exists():
                # 🛡️ SAFETY NET: Preserve existing wallpapers
                wallpaper_backup = None
                self.progress.emit(12, "📦 Checking for existing wallpapers...")
                
                # 1. Backup wallpapers if they exist
                if (preset_dir / "wallpapers").exists():
                    wallpaper_backup = preset_dir / "wallpapers.old"
                    if wallpaper_backup.exists():
                        shutil.rmtree(wallpaper_backup)
                    shutil.move(str(preset_dir / "wallpapers"), str(wallpaper_backup))
                    self.progress.emit(15, "   📁 Renamed wallpapers/ → wallpapers.old/")
                    _printer.debug(f"Preserved old wallpapers: {wallpaper_backup}")
                else:
                    self.progress.emit(15, "   ℹ️  No existing wallpapers to preserve")
                
                # 2. Remove only the INI (Wini owns it and will rewrite it).
                #    Everything else — themes/, icons (wsN.png), etc. — is
                #    preserved so that Baker and user assets survive a regen.
                self.progress.emit(20, "🗑️  Removing old INI...")
                ini_file = preset_dir / f"{self.preset_name}.ini"
                if ini_file.exists():
                    ini_file.unlink()
                
                self.progress.emit(25, "   ✅ Old preset removed (kept wallpapers.old)")
                preset_dir.mkdir(parents=True, exist_ok=True)
            else:
                preset_dir.mkdir(parents=True, exist_ok=True)
                _printer.debug(f"Created new preset directory: {preset_dir}")
            
            # Create theme directories (baker will fill these later)
            self.progress.emit(30, "Creating theme directories...")
            (preset_dir / 'themes' / 'gtk').mkdir(parents=True, exist_ok=True)
            (preset_dir / 'themes' / 'icons').mkdir(parents=True, exist_ok=True)
            (preset_dir / 'themes' / 'cursor').mkdir(parents=True, exist_ok=True)
            
            # --- STEP 1: Generate INI ---
            self.progress.emit(35, "Generating INI file...")
            ini_path = preset_dir / f"{self.preset_name}.ini"

            if self.shuffle_plan is not None:
                with open(ini_path, 'w') as f:
                    f.write(self.generate_ini_content_from_plan(self.shuffle_plan))
                _printer.debug(f"Generated INI from shuffle plan: {ini_path}")
            else:
                with open(ini_path, 'w') as f:
                    f.write(self.generate_ini_content())
                _printer.debug(f"Generated INI: {ini_path}")
            
            # --- STEP 2: Create wallpaper folders ---
            self.progress.emit(50, "Creating wallpaper folders...")
            for i in range(1, self.workspace_count + 1):
                ws_name = f"ws{i}"
                wallpaper_dir = preset_dir / "wallpapers" / ws_name
                wallpaper_dir.mkdir(parents=True, exist_ok=True)
                self.progress.emit(50 + i * 2, f"Created: wallpapers/{ws_name}/")
            
            # --- STEP 3: Generate wallpapers ---
            self.progress.emit(70, "🎨 Generating wallpapers...")
            generated_count = 0
            
            config = configparser.ConfigParser()
            config.read(ini_path)
            
            for i in range(1, self.workspace_count + 1):
                section = f"ws{i}"
                if config.has_section(section) and config.has_option(section, 'icon_color'):
                    color = config.get(section, 'icon_color')
                    wallpaper_dir = preset_dir / "wallpapers" / f"ws{i}"
                    output_path = wallpaper_dir / f"wallpaper{i}.png"
                    
                    if generate_wallpaper(self.wallpaper_style, color, output_path):
                        generated_count += 1
                        self.progress.emit(70 + i * 3, f"Generated wallpaper for ws{i}")
                    else:
                        src = self.find_wallpaper(i)
                        if src:
                            shutil.copy2(src, wallpaper_dir / src.name)
                            self.progress.emit(70 + i * 3, f"Copied fallback: {src.name}")
                            _printer.debug(f"Fallback wallpaper for ws{i}: {src.name}")
                        else:
                            self.progress.emit(70 + i * 3, f"⚠️  No wallpaper for ws{i}")
                            _printer.warning(f"No wallpaper found for ws{i}")
                else:
                    self.progress.emit(70 + i * 3, f"⚠️  No color found for ws{i}")
                    _printer.warning(f"No color found for ws{i} in INI")
            
            if generated_count > 0:
                self.progress.emit(85, f"✅ Generated {generated_count} wallpapers")
                _printer.success(f"Generated {generated_count} wallpapers")
            else:
                self.progress.emit(85, "⚠️  No wallpapers generated")
                _printer.warning("No wallpapers generated")
            
            self.progress.emit(100, "Preset created successfully!")
            
            # Build summary message
            summary = f"✅ Preset '{self.preset_name}' created successfully!\n\n"
            summary += f"Location: {preset_dir}\n\n"
            summary += f"📁 Workspace folders created:\n"
            summary += "\n".join([f"   - wallpapers/ws{i}/" for i in range(1, self.workspace_count + 1)])
            
            if self.shuffle_enabled:
                summary += f"\n\n🎲 Shuffle was applied - random colors and themes generated!"
            
            if generated_count > 0:
                summary += f"\n\n🎨 Wallpapers generated: {generated_count}/{self.workspace_count}"
            
            if (preset_dir / "wallpapers.old").exists():
                summary += f"\n\n🛡️  Old wallpapers preserved in: wallpapers.old/"
                summary += f"\n   To recover: cp -r wallpapers.old/* wallpapers/"
                summary += f"\n   To delete: rm -rf wallpapers.old/"
            
            summary += f"\n\n📝 Next steps:"
            summary += f"\n   1. Run 'baker' to generate themes"
            summary += f"\n   2. Run 'awp_start.sh {self.preset_name}' to activate"
            
            self.finished.emit(True, summary)
            _printer.success(f"Preset '{self.preset_name}' ready for baking!")
            
        except Exception as e:
            _printer.error(f"Error creating preset: {e}")
            self.finished.emit(False, f"❌ Error creating preset:\n\n{str(e)}")
        
