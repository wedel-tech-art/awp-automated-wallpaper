def detect_de() -> str:
    # Check each detector in priority order
    for backend, detector in BACKEND_DETECTORS.items():
        try:
            if detector():
                return backend
        except:
            continue
    return "generic"

def detect_session_type() -> str:
    if os.environ.get('WAYLAND_DISPLAY'):
        return 'wayland'
    elif os.environ.get('DISPLAY'):
        return 'x11'
    else:
        return 'unknown'

def detect_os() -> str:
    """Detect operating system from /etc/os-release"""
    try:
        with open('/etc/os-release', 'r') as f:
            for line in f:
                if line.startswith('ID='):
                    os_id = line.strip().split('=')[1].strip('"')
                    return os_id
    except:
        pass
    
    # Fallback detection
    if os.path.exists("/etc/debian_version"):
        return "debian"
    elif os.path.exists("/etc/arch-release"):
        return "arch"
    elif os.path.exists("/etc/redhat-release"):
        return "fedora"
    else:
        return "linux"

def detect_workspace_count() -> int:
    # Try Qtile first
    try:
        result = subprocess.run(
            ["qtile", "cmd-obj", "-o", "group", "-f", "info"],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            groups = json.loads(result.stdout)
            return len(groups)
    except:
        pass
    
    # Try XFCE
    try:
        if os.system("pgrep -x xfce4-session > /dev/null 2>&1") == 0:
            if shutil.which("xfconf-query"):
                result = subprocess.run(
                    ["xfconf-query", "-c", "xfwm4", "-p", "/general/workspace_count"],
                    capture_output=True, text=True
                )
                if result.returncode == 0 and result.stdout.strip().isdigit():
                    return int(result.stdout.strip())
    except:
        pass
    
    # Try GNOME (fixed workspaces)
    try:
        if os.system("pgrep -x gnome-shell > /dev/null 2>&1") == 0:
            result = subprocess.run(
                ["gsettings", "get", "org.gnome.desktop.wm.preferences", "num-workspaces"],
                capture_output=True, text=True
            )
            if result.returncode == 0 and result.stdout.strip().isdigit():
                return int(result.stdout.strip())
    except:
        pass
    
    # Try Cinnamon
    try:
        if os.system("pgrep -x cinnamon > /dev/null 2>&1") == 0:
            result = subprocess.run(
                ["gsettings", "get", "org.cinnamon.desktop.wm.preferences", "num-workspaces"],
                capture_output=True, text=True
            )
            if result.returncode == 0 and result.stdout.strip().isdigit():
                return int(result.stdout.strip())
    except:
        pass
    
    # Fallback
    return 8

