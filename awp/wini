    def _get_accent_color(self) -> str:
        """Read the derived accent from awp-qt-color.conf (matches Qt6 apps)."""
        fallback = AWP_FALLBACK_ACCENT
        try:
            with open(QT6_ACCENT_SHM, "r") as f:
                for line in f:
                    if line.startswith("active_colors="):
                        parts = line.split("=", 1)[1].strip().split(",")
                        if parts:
                            last = parts[-1].strip().lstrip("#")
                            if len(last) == 8:
                                last = last[2:]  # strip alpha
                            if len(last) == 6:
                                return f"#{last.lower()}"
        except (FileNotFoundError, OSError):
            pass
        return fallback
    
