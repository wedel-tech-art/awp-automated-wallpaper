MIN_NEIGHBOR_HUE_GAP = 35

# Every pair of workspaces (not just neighbours) must look clearly different.
# Distance is measured in CIE Lab (perceptual); lightness counts half as much as
# hue/chroma so "same colour, lighter" still counts as similar.
# ~45 is reliably reachable with 8 workspaces; the ceiling is about 53.
MIN_COLOR_DISTANCE = 45
COLOR_L_WEIGHT = 0.5
