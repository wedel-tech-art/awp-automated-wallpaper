    def _detect_active_preset(self):
        """
        Return the name of the currently active AWP preset, or None if no
        preset is active (fresh install, daemon not running, etc.).
        """
        try:
            with open(SHM_ACTIVE_PRESET, "r") as f:
                name = f.read().strip()
                if name:
                    return name
        except (FileNotFoundError, OSError):
            pass
        return None
    
    def _load_active_ini_data(self):
        """
        Read the active preset's INI and return its data as a dict:
            {
                "general": {"os_detected": ..., "session_type": ..., "workspaces": ...},
                "workspaces": [
                    {"section": "ws1", "icon_color": ..., "folder": ..., ...},
                    {"section": "ws2", ...},
                    ...
                ]
            }

        Reads the INI on disk (the authoritative source), then falls back
        to the RAM mirror if the disk file is unreadable. The RAM mirror
        can be stale — it only reflects the config as of the last time the
        running system reloaded it, so a hand-edited INI wouldn't be picked
        up. The disk file is what the user actually sees and edits.

        Returns None if neither source can be read.
        """
        if not self.active_preset:
            return None

        ini_path = self.presets_dir / self.active_preset / f"{self.active_preset}.ini"

        # ── Preferred: the INI on disk ──
        if ini_path.exists():
            try:
                config = configparser.ConfigParser()
                config.read(ini_path)

                general = dict(config["general"]) if config.has_section("general") else {}
                workspaces = []
                for section in config.sections():
                    if section.startswith("ws") and section != "general":
                        entry = dict(config[section])
                        entry["section"] = section
                        workspaces.append(entry)
                workspaces.sort(key=lambda w: int(w["section"][2:]))
                return {"general": general, "workspaces": workspaces}
            except Exception as e:
                _printer.warning(
                    f"Could not read INI at {ini_path}: {e} — falling back to RAM mirror",
                    backend="wini",
                )

        # ── Fallback: the RAM mirror ──
        # Only reached if the disk INI is missing or malformed.
        try:
            with open(AWP_CONFIG_RAM, "r") as f:
                ram_data = json.load(f)

            general = ram_data.get("general", {})
            workspaces = []
            for key, value in ram_data.items():
                if key.startswith("ws") and isinstance(value, dict):
                    entry = dict(value)
                    entry["section"] = key
                    workspaces.append(entry)
            workspaces.sort(key=lambda w: int(w["section"][2:]))
            return {"general": general, "workspaces": workspaces}
        except (FileNotFoundError, json.JSONDecodeError, OSError) as e:
            _printer.error(
                f"Could not read active preset (disk INI and RAM mirror both failed): {e}",
                backend="wini",
            )
            return None
    
    def _prefill_from_ini(self):
        """Prefill the config combos + preset name from self.source_data."""
        if not self.source_data:
            return

        general = self.source_data.get("general", {})

        # Backend combo — from INI [general] os_detected
        backend = general.get("os_detected")
        if backend:
            idx = self.backend_combo.findData(backend)
            if idx >= 0:
                self.backend_combo.setCurrentIndex(idx)

        # Session combo — from INI [general] session_type
        session = general.get("session_type")
        if session:
            self.session_combo.setCurrentText(session)

        # Workspace count — from INI [general] workspaces
        try:
            n_ws = int(general.get("workspaces", 8))
            self.ws_combo.setCurrentIndex(n_ws - 1)
        except (ValueError, TypeError):
            pass

        # Preset name + OS combo — split the active preset name on the last dash
        if self.active_preset:
            parts = self.active_preset.rsplit("-", 1)
            if len(parts) == 2:
                prefix, suffix = parts
                self.prefix_input.setText(prefix)
                self.suffix_label.setText(f"-{suffix}")

                # Sync OS combo to the suffix
                os_idx = self.os_combo.findText(suffix)
                if os_idx >= 0:
                    self.os_combo.setCurrentIndex(os_idx)
            else:
                # No dash in the name — treat the whole thing as prefix
                self.prefix_input.setText(self.active_preset)

    def _reset_combos_to_defaults(self):
        """Restore the combos to the detected defaults (when Use INI is off)."""
        idx = self.backend_combo.findData(self.detected_de)
        if idx >= 0:
            self.backend_combo.setCurrentIndex(idx)

        self.os_combo.setCurrentText(self.detected_os)
        self.session_combo.setCurrentText(self.detected_session)
        self.ws_combo.setCurrentIndex(self.detected_ws - 1)

        self.prefix_input.setText(self.detected_de)
        self.suffix_label.setText(f"-{self.detected_os}")
    
    def _restore_combo_state(self, state):
        """Restore combos to a previously saved state."""
        if not state:
            return

        idx = self.backend_combo.findData(state.get("backend"))
        if idx >= 0:
            self.backend_combo.setCurrentIndex(idx)

        os_text = state.get("os")
        if os_text:
            self.os_combo.setCurrentText(os_text)

        session = state.get("session")
        if session:
            self.session_combo.setCurrentText(session)

        n_ws = state.get("workspaces")
        if n_ws:
            self.ws_combo.setCurrentIndex(n_ws - 1)

        prefix = state.get("prefix")
        if prefix:
            self.prefix_input.setText(prefix)
    
