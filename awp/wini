            self.hud_window = None
        super().closeEvent(event)
    
    def create_preset(self):
        """Create the preset."""
        backend = self.backend_combo.currentData()
        os_name = self.os_combo.currentText().strip().lower()
        session_type = self.session_combo.currentText()
        workspace_count = self.ws_combo.currentData()
        shuffle_enabled = self.shuffle_btn.isChecked()
        wallpaper_style = self.get_selected_style_id()

        # Validate the wallpaper combination
        if wallpaper_style not in WALLPAPER_SVG_TEMPLATES:
            QMessageBox.warning(self, "Unavailable Combination",
                f"This background + logo combination isn't available:\n\n"
                f"  {wallpaper_style}\n\n"
                f"Please pick a different combination.")
            return
        
        # Build preset name from prefix + suffix
        prefix = self.prefix_input.text().strip()
        suffix = self.suffix_label.text().strip().lstrip('-')
        
        if not prefix:
            QMessageBox.warning(self, "Validation Error", "Please enter a preset prefix.")
            return
        
        if not suffix:
            QMessageBox.warning(self, "Validation Error", "OS suffix not set.")
            return
        
        # Sanitize prefix
        prefix = re.sub(r'[^a-zA-Z0-9_-]', '', prefix)
        self.prefix_input.setText(prefix)
        
        preset_name = f"{prefix}-{suffix}"

        if not os_name:
            QMessageBox.warning(self, "Validation Error", "Please select or type an operating system name.")
            return
        
        preset_dir = self.presets_dir / preset_name
        if preset_dir.exists():
            is_active = (self.active_preset is not None
                         and preset_name == self.active_preset)

            if is_active:
                title = "Active Preset"
                message = (
                    f"'{preset_name}' is the currently ACTIVE preset.\n\n"
                    f"Overwriting will replace its INI and its wallpapers.\n"
                    f"If the AWP daemon is running, it will reload this preset.\n\n"
                    f"Your current wallpapers will be preserved in "
                    f"wallpapers.old/ — but the INI edits will NOT be preserved.\n\n"
                    f"Overwrite the active preset?"
                )
            else:
                title = "Preset Exists"
                message = f"Preset '{preset_name}' already exists.\n\nOverwrite?"

            reply = QMessageBox.question(
                self, title, message,
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No   # ← default to No
            )
            if reply != QMessageBox.StandardButton.Yes:
                return
        
        self.create_btn.setEnabled(False)
        self.create_btn.setText("⏳ Creating...")
        self.progress_bar.setVisible(True)
        self.progress_bar.setValue(0)
        self.statusBar().showMessage("Creating preset...")
        
        # Build source_workspaces from self.source_data when in INI mode
        source_workspaces = None
        if self.ini_btn.isChecked() and self.source_data:
            source_workspaces = {
                ws["section"]: ws
                for ws in self.source_data["workspaces"]
            }

        self.worker = PresetCreatorWorker(
            preset_name, backend, os_name, session_type, workspace_count,
            shuffle_enabled, wallpaper_style=wallpaper_style,
            shuffle_plan=self.pending_shuffle,
            source_workspaces=source_workspaces,
        )
        self.worker.progress.connect(self.update_progress)
        self.worker.finished.connect(self.creation_finished)
        self.worker.start()
    
    def update_progress(self, value: int, message: str):
        self.progress_bar.setValue(value)
        self.statusBar().showMessage(message)
        QApplication.processEvents()
    
    def creation_finished(self, success: bool, message: str):
        self.progress_bar.setVisible(False)
        self.create_btn.setEnabled(True)
        self.create_btn.setText("🧙 Create Preset")
        
        # Reset shuffle button state after creation
        if self.shuffle_btn.isChecked():
            self.shuffle_btn.setChecked(False)
            self.statusBar().setStyleSheet("")
        
        if success:
            self.statusBar().showMessage("Preset created successfully!")
            
            preset_name = f"{self.prefix_input.text().strip()}-{self.suffix_label.text().strip().lstrip('-')}"
            preset_dir = self.presets_dir / preset_name
            
            msg = f"✅ Preset '{preset_name}' created successfully!\n\n"
            msg += f"Location: {preset_dir}\n\n"
            msg += "📁 Wallpaper folders created:\n"
            msg += "\n".join([f"   - wallpapers/ws{i}/" for i in range(1, self.ws_combo.currentData() + 1)])
            
            if (preset_dir / "wallpapers.old").exists():
                msg += f"\n\n🛡️  Old wallpapers preserved in: wallpapers.old/"
                msg += f"\n   To recover: cp -r wallpapers.old/* wallpapers/"
                msg += f"\n   To delete: rm -rf wallpapers.old/"
            
            msg += "\n\nNext steps:\n"
            msg += "1. Run 'baker' to generate themes\n"
            msg += "2. Run 'awp_start.sh <preset_name>' to use it\n"
            msg += "3. Add wallpapers to the workspace folders"
            
            QMessageBox.information(self, "Preset Created", msg)
        else:
            self.statusBar().showMessage("Creation failed!")
            QMessageBox.critical(self, "Error", message)

def run_gui() -> int:
    """Launch the GUI wizard. Returns a process exit code."""
    app = QApplication(sys.argv)

    palette = QPalette()
    palette.setColor(QPalette.ColorRole.Window, QColor(42, 42, 42))
    palette.setColor(QPalette.ColorRole.WindowText, QColor(221, 221, 221))
    palette.setColor(QPalette.ColorRole.Base, QColor(60, 60, 60))
    palette.setColor(QPalette.ColorRole.AlternateBase, QColor(46, 46, 46))
    palette.setColor(QPalette.ColorRole.Text, QColor(221, 221, 221))
    palette.setColor(QPalette.ColorRole.Button, QColor(68, 68, 68))
    palette.setColor(QPalette.ColorRole.ButtonText, QColor(221, 221, 221))
    palette.setColor(QPalette.ColorRole.HighlightedText, QColor(255, 255, 255))
    app.setPalette(palette)

    window = WiniGUI()
    window.show()
    return app.exec()

# =============================================================================
# CLI MODE — headless wallpaper generation
# =============================================================================
#
# Wini's primary interface is the GUI wizard. This CLI mode exists so that
# other tools (Baker, DAB, future scripts) can regenerate a single wallpaper
# without launching the GUI. It generates one PNG from one template + one color.
#
# Usage:
#   wini --generate-wallpaper --template awp-cave --color "#b7004f" \
#        --output /path/to/out.png
#
# Or, using the background/logo pieces (Wini combines them):
#   wini --generate-wallpaper --bg cave --logo awp --color "#b7004f" \
#        --output /path/to/out.png
#
# If --template is omitted, defaults to the AWP branded template.
# =============================================================================


def parse_args():
    """Parse CLI arguments. Returns the argparse Namespace."""
    parser = argparse.ArgumentParser(
        prog="wini",
        description=(
            "Wini — Wizard of INI. Launch with no arguments to open the GUI, "
            "or use --generate-wallpaper for headless wallpaper generation."
        ),
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )

    # Headless mode trigger
    parser.add_argument(
        "--generate-wallpaper",
        action="store_true",
        help="Headless mode: generate a single wallpaper PNG and exit.",
    )

    # Template selection — two input modes
    parser.add_argument(
        "--template",
        type=str,
        default=None,
        help=(
            "Composite template ID (e.g. 'awp-cave', 'awp-center'). "
            "If given, takes precedence over --bg/--logo."
        ),
    )
    parser.add_argument(
        "--bg",
        type=str,
        default=None,
        help=(
            "Background ID (e.g. 'cave', 'awp-center', 'fire'). "
            "Combined with --logo to form the final template ID."
        ),
    )
    parser.add_argument(
        "--logo",
        type=str,
        default=None,
        help=(
            "Logo ID (e.g. 'awp', 'debian', 'kde'). "
            "Ignored for no-logo backgrounds."
        ),
    )

    # Required for headless mode
    parser.add_argument(
        "--color",
        type=str,
        default=None,
        help="Target hex color (e.g. '#b7004f'). Required with --generate-wallpaper.",
    )
    parser.add_argument(
        "--output",
        type=str,
        default=None,
        help=(
            "Output PNG path. The filename component is rewritten by Wini "
            "to match the template's naming convention "
            "(e.g. <prefix>-<hue>-<hex>.png). The parent directory is created "
            "if it doesn't exist. Required with --generate-wallpaper."
        ),
    )

    return parser.parse_args()


def resolve_template_id(template, bg, logo):
    """
    Determine the final composite template ID from CLI args.

    Priority:
      1. --template (explicit composite ID)
      2. --bg + --logo (combined)
      3. --bg alone (if no_logo, use bg_id; else fall back to default)
      4. Default template (awp-center)

    Returns a string that is guaranteed to be a key in WALLPAPER_SVG_TEMPLATES
    (or the default if none of the inputs resolve to a valid template).
    """
    # 1. Explicit template
    if template:
        if template in WALLPAPER_SVG_TEMPLATES:
            return template
        print(f"wini: warning: unknown template '{template}', using default",
              file=sys.stderr)
        return DEFAULT_WALLPAPER_TEMPLATE

    # 2. bg + logo (composite)
    if bg:
        bg_data = BACKGROUNDS.get(bg, {})
        if bg_data.get("no_logo"):
            # No-logo background: the bg ID is the template ID
            return bg
        if logo:
            composite = f"{logo}-{bg}"
            if composite in WALLPAPER_SVG_TEMPLATES:
                return composite
            print(f"wini: warning: '{composite}' is not a known template, "
                  f"using default", file=sys.stderr)
            return DEFAULT_WALLPAPER_TEMPLATE
        # bg requires a logo but none was given
        print(f"wini: warning: --bg {bg} requires --logo, using default",
              file=sys.stderr)
        return DEFAULT_WALLPAPER_TEMPLATE

    # 3-4. Default
    return DEFAULT_WALLPAPER_TEMPLATE


def run_cli(args) -> int:
    """
    Headless wallpaper generation. Returns a process exit code.
    """
    if not args.color:
        print("wini: error: --generate-wallpaper requires --color", file=sys.stderr)
        return 1
    if not args.output:
        print("wini: error: --generate-wallpaper requires --output", file=sys.stderr)
        return 1

    template_id = resolve_template_id(args.template, args.bg, args.logo)
    output_path = Path(args.output)

    ok = generate_wallpaper(template_id, args.color, output_path)
    if ok:
        print(f"wini: generated wallpaper ({template_id}, {args.color})")
        return 0
    else:
        print(f"wini: failed to generate wallpaper", file=sys.stderr)
        return 1


def main():
    """Entry point: dispatch to CLI or GUI based on arguments."""
    args = parse_args()

    if args.generate_wallpaper:
        return run_cli(args)
    else:
        return run_gui()

if __name__ == "__main__":
    sys.exit(main())
