    def refresh_theme_lists(self):
        """Refresh theme lists for the current workspace widget using cache."""
        if not hasattr(self, 'workspace_widget'):
            return
        
        all_themes_dict = get_available_themes()
        
        mapping = {
            "icon_theme": "icon_themes",
            "gtk_theme": "gtk_themes",
            "cursor_theme": "cursor_themes",
            "desktop_theme": "desktop_themes",
            "wm_theme": "wm_themes"
        }
        
        # Get current workspace number from the widget
        ws_num = self.workspace_widget.current_ws
        section = f'ws{ws_num}'
        
        # Get the cached config for this workspace
        cached_config = self.workspace_widget.ws_cache.get(ws_num, {})
        
        for key, combo in self.workspace_widget.theme_controls.items():
            # Get saved value from cache (not INI!)
            saved_val = cached_config.get(key, '')
            theme_type = mapping.get(key)
            theme_list = all_themes_dict.get(theme_type, [])
            
            combo.blockSignals(True)
            combo.clear()
            
            # Always start with (Not set) as the first option
            combo.addItem("(Not set)", "")
            
            # Fill with themes
            for theme in theme_list:
                combo.addItem(theme)
                
            # Set the selection from cache
            if saved_val and saved_val.strip() != "":
                idx = combo.findText(saved_val)
                if idx >= 0:
                    combo.setCurrentIndex(idx)
                else:
                    combo.addItem(saved_val)
                    new_idx = combo.findText(saved_val)
                    combo.setCurrentIndex(new_idx)
            else:
                combo.setCurrentIndex(0)  # "(Not set)"
            
            combo.blockSignals(False)
    
    def on_preset_changed(self, index):
        """Handle preset selection change."""
        if index < 0:
            return
        
        preset_name = self.preset_combo.currentData()
        
        if not preset_name or preset_name == self.current_preset:
            return
        
        if self.load_preset(preset_name):
            self.preset_combo.blockSignals(True)
            self.preset_combo.clear()
            for preset in AVAILABLE_PRESETS:
                is_system = preset == self.system_preset  # ← Always system
                is_current = preset == self.current_preset  # ← DAB's current
                
                label = f"{preset} {'✓' if is_system else ''}"
                self.preset_combo.addItem(label, preset)
                if is_current:
                    self.preset_combo.setCurrentIndex(self.preset_combo.count() - 1)
            self.preset_combo.blockSignals(False)

    def load_preset(self, preset_name):
        """Load a specific preset's INI file."""
        if preset_name not in AVAILABLE_PRESETS:
            _printer.error(f"Unknown preset: {preset_name}", backend="dab")
            return False
        
        preset_path = os.path.join(PRESETS_DIR, preset_name)
        ini_path = os.path.join(preset_path, f"{preset_name}.ini")
        
        if not os.path.exists(ini_path):
            _printer.error(f"Preset INI not found: {ini_path}", backend="dab")
            return False
        
        _printer.info(f"Loading preset: {preset_name}", backend="dab")
        
        # Reload config
        self.config = AWPConfig(ini_path)
        self.current_preset = preset_name
        
        # Clear and rebuild cache
        if hasattr(self, 'workspace_widget'):
            self.workspace_widget.ws_cache = {}
            self.workspace_widget.load_all_workspaces()
            self.workspace_widget.load_from_config(0)
            self.workspace_widget.update_icon_preview()
            self.workspace_widget.current_ws = 1
        
        # Update UI
        self.update_info_labels()
        self.update_workspace_combo()
        self.refresh_theme_lists()
        self.setWindowTitle(f"AWP Dashboard - {preset_name}")
        
        # Update info colors with system accent (reads from SHM)
        self.update_info_colors()  # ← No arguments, no cache reading
        
        _printer.success(f"Loaded preset: {preset_name} ({self.config.workspaces_count} workspaces)", backend="dab")
        return True
    
    def on_workspace_changed(self, index):
        """Handle workspace selection change."""
        if index < 0:
            return
        
        if hasattr(self, 'workspace_widget'):
            # Save current workspace UI state to cache BEFORE switching
            self.workspace_widget.save_current_to_cache()
            
            # Load new workspace from cache
            ws_num = index + 1
            self.workspace_widget.load_from_config(index)
            self.workspace_widget.update_icon_preview()
            self.setWindowTitle(f"AWP Dashboard - Workspace {ws_num}")
            self.refresh_theme_lists()
            
