    def load_all_workspaces(self):
        """Load ALL workspaces from INI into cache at startup."""
        if self.is_loading:
            return
        self.is_loading = True
        
        num_workspaces = self.parent_window.config.workspaces_count
        for ws_num in range(num_workspaces):
            ws_config = self.parent_window.config.get_workspace_config(ws_num)
            self.ws_cache[ws_num + 1] = ws_config  # 1-based key
        _printer.info(f"Loaded {num_workspaces} workspaces into cache", backend="dab")
    
        self.is_loading = False 
           
    def _apply_config(self, ws_config):
        """Apply configuration to UI widgets."""
        # Basic settings
        self.folder_edit.setText(ws_config['folder'])
        self.icon_edit.setText(ws_config['icon'])
        
        # Color
        color_val = ws_config.get('icon_color', '')
        self.color_edit.setText(color_val)
        if color_val and color_val.startswith('#'):
            self.color_preview.setStyleSheet(f"background-color: {color_val}; border: 1px solid #555; border-radius: 4px;")
        else:
            self.color_preview.setStyleSheet("background-color: #888; border: 1px solid #555; border-radius: 4px;")
        
        # Timing
        timing = ws_config['timing']
        for i in range(self.timing_combo.count()):
            if self.timing_combo.itemData(i) == timing:
                self.timing_combo.setCurrentIndex(i)
                break
        else:
            self.timing_combo.setCurrentText("5 minutes")
        
        # Mode and order
        mode = ws_config['mode']
        self.mode_combo.setCurrentText(mode.title())
        
        if mode == "random":
            found_n = False
            for i in range(self.order_combo.count()):
                if self.order_combo.itemData(i) == "n":
                    found_n = True
                    self.order_combo.setCurrentIndex(i)
                    break
            if not found_n:
                self.order_combo.addItem("Random (n)", "n")
                self.order_combo.setCurrentIndex(self.order_combo.count() - 1)
            self.order_combo.setEnabled(False)
        else:
            order = ws_config['order']
            for i in range(self.order_combo.count()):
                if self.order_combo.itemData(i) == order:
                    self.order_combo.setCurrentIndex(i)
                    break
            self.order_combo.setEnabled(True)
        
        # Scaling
        scaling = ws_config['scaling']
        for i in range(self.scaling_combo.count()):
            if self.scaling_combo.itemData(i) == scaling:
                self.scaling_combo.setCurrentIndex(i)
                break
        
        # Theme settings
        for key, combo in self.theme_controls.items():
            theme_value = ws_config.get(key, '')
            if theme_value:
                found = False
                for i in range(combo.count()):
                    if combo.itemText(i) == theme_value:
                        combo.setCurrentIndex(i)
                        found = True
                        break
                if not found:
                    combo.addItem(theme_value)
                    combo.setCurrentText(theme_value)
            else:
                combo.setCurrentIndex(0)  # "(Not set)"
        
        # Update color previews for all theme combos
        for combo in self.theme_controls.values():
            self.update_theme_color(combo)
        
        self.update_theme_availability()
        self.update_icon_preview()
    
    def update_theme_availability(self):
        """Update theme dropdown availability based on current DE/WM."""
        de = self.parent_window.get_current_de().lower()
        
        # Get capabilities for this DE, fallback to generic
        caps = THEME_CAPABILITIES.get(de, THEME_CAPABILITIES['generic'])
        
        # Window Theme
        wm_combo = self.theme_controls.get('wm_theme')
        if wm_combo:
            wm_combo.setEnabled(caps['has_wm_theme'])
            if caps['has_wm_theme']:
                wm_combo.setToolTip(f"Select window borders/decorations for {de.upper()}")
            else:
                wm_combo.setToolTip(f"Window borders integrated into GTK theme")

        # Desktop Theme
        dt_combo = self.theme_controls.get('desktop_theme')
        if dt_combo:
            dt_combo.setEnabled(caps['has_desktop_theme'])
            if caps['has_desktop_theme']:
                dt_combo.setToolTip("Select the desktop shell theme")
            else:
                dt_combo.setToolTip("Desktop shell themes not applicable")

        # Universal Basics (always enabled)
        for key in ['icon_theme', 'gtk_theme', 'cursor_theme']:
            combo = self.theme_controls.get(key)
            if combo:
                combo.setEnabled(True)
                
    # --- SIGNAL HANDLERS ---
    
    def on_browse_folder(self):
        """Browse and select wallpaper folder for this workspace."""
        p = QFileDialog.getExistingDirectory(self, f"Select folder for WS{self.index}", BASE_FOLDER)
        if p:
            self.folder_edit.setText(p)

    def on_mode_changed(self, text):
        """
        Adjust order combo behavior based on rotation mode.
        
        Args:
            text (str): Current mode selection ("Random" or "Sequential")
        """
        if text == "Random":
            # Force 'n' for random mode
            found_n = False
            for i in range(self.order_combo.count()):
                if self.order_combo.itemData(i) == "n":
                    found_n = True
                    self.order_combo.setCurrentIndex(i)
                    break
            if not found_n:
                self.order_combo.addItem("Random (n)", "n")
                self.order_combo.setCurrentIndex(self.order_combo.count() - 1)
            self.order_combo.setEnabled(False)
        else:
            self.order_combo.setEnabled(True)
            # Remove 'n' if exists
            for i in range(self.order_combo.count()):
                if self.order_combo.itemData(i) == "n":
                    self.order_combo.removeItem(i)
                    break
            self.order_combo.setCurrentIndex(0)

    def update_icon_preview(self):
        """Update live preview with Hex/HSV details from config."""
        path = self.icon_edit.text().strip()
        display_path = path if (path and os.path.isfile(path)) else (DEFAULT_ICON if os.path.isfile(DEFAULT_ICON) else "")
        
        if display_path:
            pix = QPixmap(display_path)
            self.icon_preview.setPixmap(pix.scaled(60, 60, 
                Qt.AspectRatioMode.KeepAspectRatio, 
                Qt.TransformationMode.SmoothTransformation))
            
            # Get Hex from config
            section = f"ws{self.index}"
            hex_val = self.parent_window.config.get(section, 'icon_color', default='')
            
            # Convert to HSV
            hsv_info = "N/A"
            if hex_val and hex_val.startswith('#'):
                try:
                    h, s, v = hex_to_hsv(hex_val.lstrip('#'))
                    h_info = f"{int(h * 360)}º"
                    s_info = f"{int(s * 100)}%"
                    v_info = f"{int(v * 100)}%"
                except:
                    h_info = "N/A"
                    s_info = "N/A"
                    v_info = "N/A"
            
            # Build info text
            filename = os.path.basename(display_path)
            width = pix.width()
            height = pix.height()
            
            is_symlink = os.path.islink(display_path)
            real_path = os.path.realpath(display_path) if is_symlink else display_path
            
            info_lines = [
                #f"File: {filename}",
                f"Size: {width}x{height}",
                f"Hex: {hex_val.upper() if hex_val else 'N/A'}",
                f"H: {h_info}",
                f"S: {s_info}",
                f"V: {v_info}"
            ]
            
            info_text = "\n".join(info_lines)
            self.icon_info_text.setText(info_text)
            self.icon_info_text.setStyleSheet("""
                color: #aaa;
                font-size: 10px;

            """)
            
            self.icon_preview.setEnabled(True)
            
        else:
            self.icon_preview.clear()
            self.icon_preview.setText("🎨")
            self.icon_info_text.setText("No icon selected")
            self.icon_info_text.setStyleSheet("""
                color: #666;
                font-size: 10px;
                background: #2a2a2a;
                border: 1px solid #444;
                border-radius: 4px;
                padding: 4px;
            """)
            self.icon_preview.setEnabled(True)

    def update_theme_color(self, combo):
        """Update the color preview for a combo when selection changes."""
        theme_name = combo.currentText()
        color = extract_color_from_theme(theme_name)
        
        if hasattr(combo, 'color_preview'):
            if color:
                combo.color_preview.setStyleSheet(f"""
                    background-color: {color}; 
                    border: 2px solid {color}; 
                    border-radius: 4px;
                """)
                combo.color_preview.setToolTip(f"Color: {color}")
            else:
                combo.color_preview.setStyleSheet("""
                    background-color: #888; 
                    border: 1px solid #555; 
                    border-radius: 4px;
                """)
                combo.color_preview.setToolTip("No color detected")
    
    def create_theme_row(self, label_text, combo):
        """Create a row with label, combo, and color preview."""
        row = QHBoxLayout()
        row.setSpacing(5)
        
        # Label
        lbl = QLabel(f"{label_text}:")
        lbl.setFixedWidth(120)
        lbl.setToolTip(f"Select {label_text.lower()} for this workspace")
        row.addWidget(lbl)
        
        # Combo
        row.addWidget(combo)
        
        # Color preview square
        color_preview = QLabel()
        color_preview.setFixedSize(20, 20)
        color_preview.setStyleSheet("background-color: #888; border: 1px solid #555; border-radius: 4px;")
        color_preview.setToolTip("Theme accent color")
        row.addWidget(color_preview)
        
        # Store reference to update later
        combo.color_preview = color_preview
        
        # Connect signal to update color when selection changes
        combo.currentTextChanged.connect(lambda: self.update_theme_color(combo))
        
        row.addStretch(1)
        return row

    # --- CONFIG LOAD / SAVE ---
    
    def load_from_config(self, ws_num: int):
        """Load settings from cache (not INI)."""
        if self.is_loading:
            return
        self.is_loading = True
        
        ws_num_1based = ws_num + 1
        self.current_ws = ws_num_1based
        self.index = ws_num_1based
        
        if ws_num_1based in self.ws_cache:
            ws_config = self.ws_cache[ws_num_1based]
            self._apply_config(ws_config)
            _printer.info(f"Loading WS{ws_num_1based} from cache", backend="dab")
        else:
            _printer.warning(f"Workspace {ws_num_1based} not in cache!", backend="dab")
        
        self.is_loading = False
        
    def save_current_to_cache(self):
        """Save current UI state to cache (no INI write)."""
        if self.is_loading:
            return
        
        ws_num = self.current_ws
        
        # Build config dict from current UI state
        config_dict = {
            'folder': self.folder_edit.text().strip(),
            'icon': self.icon_edit.text().strip(),
            'icon_color': self.color_edit.text().strip(),
            'timing': self.timing_combo.currentData() or '5m',
            'mode': self.mode_combo.currentText().lower(),
            'order': self.order_combo.currentData() or 'name_az',
            'scaling': self.scaling_combo.currentData() or 'scaled',
        }
        
        # Theme settings
        for key, combo in self.theme_controls.items():
            if combo.currentText() and combo.currentText() != "(Not set)":
                config_dict[key] = combo.currentText()
            else:
                config_dict[key] = ''
        
        # Store in cache
        self.ws_cache[ws_num] = config_dict
        _printer.info(f"Saved WS{ws_num} to cache", backend="dab")

    def save_all_to_ini(self):
        """Write ALL workspace cache to INI file."""
        config = self.parent_window.config
        
        for ws_num_1based, ws_config in self.ws_cache.items():
            section = f"ws{ws_num_1based}"
            # Skip icon field (read-only)
            for key, value in ws_config.items():
                if key != 'icon':  # icon is read-only, don't write
                    config.set(section, key, value)
        
        config.save()
        _printer.success(f"Saved {len(self.ws_cache)} workspaces to INI!", backend="dab")
    
    def save_to_config(self):
        """
        Save settings to AWPConfig.
        Pure configuration - NO baking, NO color detection, NO icon modifications.
        """
        config = self.parent_window.config
        # self.index is 1-based (1=WS1, 2=WS2, etc.)
        # Convert to 0-based for get_workspace_config
        ws_num = self.index - 1
        section = f"ws{self.index}"  # INI section is 1-based
        
        # Get values
        folder = self.folder_edit.text().strip()
        
        # Save settings
        config.set(section, 'folder', folder)
        config.set(section, 'timing', self.timing_combo.currentData() or '5m')
        config.set(section, 'mode', self.mode_combo.currentText().lower())
        config.set(section, 'order', self.order_combo.currentData() or 'name_az')
        config.set(section, 'scaling', self.scaling_combo.currentData() or 'scaled')

        # Theme settings
        for key, combo in self.theme_controls.items():
            if combo.currentText() and combo.currentText() != "(Not set)":
                config.set(section, key, combo.currentText())
            else:
                config.set(section, key, '')  # Clear theme


