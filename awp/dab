        self.exit_btn.setShortcut("Ctrl+Q")
        self.hud_v_btn.setShortcut("Ctrl+Shift+V")
        self.hud_h_btn.setShortcut("Ctrl+Shift+H")
        
    def create_standard_combo(self, items=None, width=200, editable=True):
        """Create a standardized combo box used across all tabs."""
        combo = QComboBox()
        combo.setFixedWidth(width)
        combo.setEditable(editable)
        combo.setInsertPolicy(QComboBox.InsertPolicy.NoInsert)  # Qt6 enum

        if editable:
            combo.lineEdit().setReadOnly(True)
            combo.lineEdit().setAlignment(Qt.AlignmentFlag.AlignLeft)  # Qt6 enum

        if items:
            for item in items:
                if isinstance(item, tuple):
                    combo.addItem(item[0], item[1])
                else:
                    combo.addItem(item, item)
        return combo

    def get_current_de(self):
        """Get current desktop environment from config."""
        return self.config.de  # Read directly from config

    def load_config(self):
        """Load all settings from AWPConfig into cache."""
        # Update info labels
        self.update_info_labels()
        
        # Update workspace combo
        self.update_workspace_combo()

        # Load ALL workspaces into cache
        if hasattr(self, 'workspace_widget'):
            self.workspace_widget.load_all_workspaces()
            self.workspace_widget.load_from_config(0)  # Load WS1 from cache
            self.workspace_widget.update_icon_preview()
            
            # Block signal to prevent on_workspace_changed from firing
            self.ws_combo.blockSignals(True)
            self.ws_combo.setCurrentIndex(0)  # Select WS1 in combo
            self.ws_combo.blockSignals(False)
            
            self.setWindowTitle(f"AWP Dashboard - {self.current_preset}")
            self.refresh_theme_lists()
            
            # Update info colors with system accent (reads from SHM)
            self.update_info_colors()

    def reset_config(self):
        """Discard ALL unsaved changes and reload everything from INI."""
        # Clear the cache
        if hasattr(self, 'workspace_widget'):
            self.workspace_widget.ws_cache = {}
        
        # Reload everything from INI
        preset_path = os.path.join(PRESETS_DIR, self.current_preset)
        ini_path = os.path.join(preset_path, f"{self.current_preset}.ini")
        
        if os.path.exists(ini_path):
            self.config = AWPConfig(ini_path)
            _printer.info(f"Reloaded preset: {self.current_preset}", backend="dab")
        else:
            _printer.warning(f"Preset INI not found: {ini_path}", backend="dab")
            self.config = AWPConfig()
        
        # Reload everything
        self.load_config()
        
        _printer.success("Reset to saved state", backend="dab")
    
    def save_config(self):
        """Save all cached data to INI."""
        try:
            _printer.info(f"Saving to preset: {self.current_preset}", backend="dab")
            
            # Save all workspace data from cache
            if hasattr(self, 'workspace_widget'):
                # First save current UI state to cache
                self.workspace_widget.save_current_to_cache()
                # Then write entire cache to INI
                self.workspace_widget.save_all_to_ini()
            
            _printer.success(f"Configuration saved successfully to {self.current_preset}!", backend="dab")
            QMessageBox.information(self, "Success", f"All workspaces saved to '{self.current_preset}'!")
                
        except Exception as e:
            _printer.error(f"Failed to save: {str(e)}", backend="dab")
            QMessageBox.critical(self, "Error", f"Failed to save: {str(e)}")
    
    def backup_config(self):
        """Create backup of current configuration file."""
        if os.path.exists(self.config.path):
            backup_path = str(self.config.path) + ".backup"
            shutil.copy(str(self.config.path), backup_path)
            _printer.success(f"Configuration backed up to: {backup_path}", backend="dab")
            QMessageBox.information(self, "Backup Created", 
                                  f"Configuration backed up to:\n{backup_path}")
        else:
            _printer.warning("No configuration file found to backup.", backend="dab")
            QMessageBox.warning(self, "No Config", "No configuration file found.")

    def toggle_rotation(self):
        """Toggle wallpaper rotation via awp_rotate.sh."""
        awp_rotate = os.path.expanduser("~/awp/awp_rotate.sh")
        if os.path.exists(awp_rotate):
            try:
                subprocess.run([awp_rotate], check=False)
                _printer.info("Rotation toggled", backend="dab")
                #QMessageBox.information(self, "Rotation", "Wallpaper rotation toggled successfully!")
            except Exception as e:
                _printer.error(f"Failed to toggle rotation: {e}", backend="dab")
                QMessageBox.warning(self, "Error", f"Failed to toggle rotation: {e}")
        else:
            QMessageBox.warning(self, "Error", "awp_rotate.sh not found at ~/awp/awp_rotate.sh")


