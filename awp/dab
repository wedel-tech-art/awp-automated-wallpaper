class AWPDashboard(QWidget):
    """
    Main AWP Configuration Dashboard - Pure Configurator Edition.
    
    Provides comprehensive interface for managing all AWP settings:
    - Desktop environment and session configuration
    - Workspace management and count
    - Individual workspace configuration tabs
    
    NO baking, NO color detection, NO icon copying - pure configuration only.
    """
    
    def __init__(self):
        """Initialize dashboard and load existing configuration."""
        super().__init__()
        _printer.info("Starting AWP Dashboard...", backend="dab")
        self.setWindowTitle("AWP Dashboard - Configuration Editor")
        self.setFixedSize(528, 800)
        
        # Get system active preset from SHM
        self.system_preset = self._get_current_preset()
        
        # DAB starts editing the system preset
        self.current_preset = self.system_preset
        
        # Build path to the current preset's INI
        preset_path = os.path.join(PRESETS_DIR, self.current_preset)
        ini_path = os.path.join(preset_path, f"{self.current_preset}.ini")
        
        if os.path.exists(ini_path):
            self.config = AWPConfig(ini_path)
            _printer.info(f"Loaded preset: {self.current_preset}", backend="dab")
        else:
            _printer.warning(f"Preset INI not found: {ini_path}, using default", backend="dab")
            self.config = AWPConfig()
            self.current_preset = self.config.de
        
        self._hud_v_process = None
        self._hud_h_process = None
        self.setup_ui()
        self.setup_keybindings()
        self.load_config()
        self.check_hud_status()

    def _get_hud_on_style(self):
        """Style for HUD toggle buttons when ON."""
        return """
            QPushButton {
                font-weight: bold;
                font-size: 11px;
                background: #2d7d2d;
                color: white;
                border: none;
                border-radius: 6px;
                padding: 4px 8px;
            }
            QPushButton:hover {
                background: #3d9d3d;
            }
        """

    def _get_hud_off_style(self):
        """Style for HUD toggle buttons when OFF."""
        return """
            QPushButton {
                font-weight: bold;
                font-size: 11px;
                background: #3a5a7a;
                color: #ddd;
                border: none;
                border-radius: 6px;
                padding: 4px 8px;
            }
            QPushButton:hover {
                background: #4a7a9a;
            }
        """
    
    def _get_current_preset(self):
        """Read the active preset from /dev/shm/awp_active_preset."""
        if os.path.exists(SHM_ACTIVE_PRESET):
            try:
                with open(SHM_ACTIVE_PRESET, 'r') as f:
                    preset = f.read().strip()
                    if preset in AVAILABLE_PRESETS:
                        return preset
                    else:
                        _printer.warning(f"Preset '{preset}' not in AVAILABLE_PRESETS, using default", backend="dab")
            except Exception as e:
                _printer.error(f"Failed to read SHM: {e}", backend="dab")
        # Fallback to first available preset
        return AVAILABLE_PRESETS[0] if AVAILABLE_PRESETS else "qtile_xfce-debian"

    def check_hud_status(self):
        """Check if HUDs are running and update buttons accordingly."""
        import subprocess
        
        # Check vertical HUD
        result = subprocess.run(["pgrep", "-f", "hud_vertical.py"], capture_output=True)
        if result.returncode == 0:
            self.hud_v_btn.setChecked(True)
            self.hud_v_btn.setStyleSheet(self._get_hud_on_style())
        else:
            self.hud_v_btn.setChecked(False)
            self.hud_v_btn.setStyleSheet(self._get_hud_off_style())
        
        # Check horizontal HUD
        result = subprocess.run(["pgrep", "-f", "hud_bottom.py"], capture_output=True)
        if result.returncode == 0:
            self.hud_h_btn.setChecked(True)
            self.hud_h_btn.setStyleSheet(self._get_hud_on_style())
        else:
            self.hud_h_btn.setChecked(False)
            self.hud_h_btn.setStyleSheet(self._get_hud_off_style())
    
    def toggle_hud_v(self):
        """Toggle vertical HUD on/off."""
        if self.hud_v_btn.isChecked():
            # Start vertical HUD
            hud_path = os.path.expanduser("~/awp/hud_vertical.py")
            if os.path.exists(hud_path):
                # Kill any existing vertical HUD first
                subprocess.run(["pkill", "-f", "hud_vertical.py"], stderr=subprocess.DEVNULL)
                self._hud_v_process = subprocess.Popen(["python3", hud_path])
                _printer.info("Vertical HUD started", backend="dab")
                self.hud_v_btn.setStyleSheet(self._get_hud_on_style())
            else:
                _printer.error("hud_vertical.py not found", backend="dab")
                self.hud_v_btn.setChecked(False)
        else:
            # Stop vertical HUD
            subprocess.run(["pkill", "-f", "hud_vertical.py"], stderr=subprocess.DEVNULL)
            if hasattr(self, '_hud_v_process'):
                self._hud_v_process = None
            _printer.info("Vertical HUD stopped", backend="dab")
            self.hud_v_btn.setStyleSheet(self._get_hud_off_style())

    def toggle_hud_h(self):
        """Toggle horizontal HUD on/off."""
        if self.hud_h_btn.isChecked():
            # Start horizontal HUD
            hud_path = os.path.expanduser("~/awp/hud_bottom.py")
            if os.path.exists(hud_path):
                # Kill any existing horizontal HUD first
                subprocess.run(["pkill", "-f", "hud_bottom.py"], stderr=subprocess.DEVNULL)
                self._hud_h_process = subprocess.Popen(["python3", hud_path])
                _printer.info("Horizontal HUD started", backend="dab")
                self.hud_h_btn.setStyleSheet(self._get_hud_on_style())
            else:
                _printer.error("hud_bottom.py not found", backend="dab")
                self.hud_h_btn.setChecked(False)
        else:
            # Stop horizontal HUD
            subprocess.run(["pkill", "-f", "hud_bottom.py"], stderr=subprocess.DEVNULL)
            if hasattr(self, '_hud_h_process'):
                self._hud_h_process = None
            _printer.info("Horizontal HUD stopped", backend="dab")
            self.hud_h_btn.setStyleSheet(self._get_hud_off_style())
    
    def closeEvent(self, event):
        """Clean up HUD processes when DAB exits."""
        import subprocess
        
        # Kill vertical HUD
        subprocess.run(["pkill", "-f", "hud_vertical.py"], stderr=subprocess.DEVNULL)
        _printer.info("Vertical HUD terminated", backend="dab")
        
        # Kill horizontal HUD
        subprocess.run(["pkill", "-f", "hud_bottom.py"], stderr=subprocess.DEVNULL)
        _printer.info("Horizontal HUD terminated", backend="dab")
        
        # Clear process references
        if hasattr(self, '_hud_v_process'):
            self._hud_v_process = None
        if hasattr(self, '_hud_h_process'):
            self._hud_h_process = None
        
        # Accept the close event (proceed with closing)
        event.accept()
    
