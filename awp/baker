    def _clean_workspace_themes(self, ws_num, gtk_theme, icon_theme, cursor_theme):
        """Remove old themes for a specific workspace from both global and preset locations."""
        theme_names = []
        if gtk_theme:
            theme_names.append(gtk_theme)
        if icon_theme:
            theme_names.append(icon_theme)
        if cursor_theme:
            theme_names.append(cursor_theme)
        
        if not theme_names:
            return []
        
        removed = []
        
        # 1. Remove from global locations (~/.themes/ and ~/.icons/)
        removed_global = clean_themes(theme_names)
        removed.extend(removed_global)
        
        # 2. Remove from preset/themes/
        selected_preset = self.preset_combo.currentData()
        themes_dir = os.path.join(self.presets_dir, selected_preset, 'themes')
        
        if os.path.exists(themes_dir):
            for theme_name in theme_names:
                # Check GTK
                gtk_path = os.path.join(themes_dir, 'gtk', theme_name)
                if os.path.exists(gtk_path):
                    shutil.rmtree(gtk_path)
                    removed.append(f"GTK: {theme_name} (preset)")
                    _printer.info(f"Removed from preset: {gtk_path}", backend="baker")
                
                # Check Icons
                icon_path = os.path.join(themes_dir, 'icons', theme_name)
                if os.path.exists(icon_path):
                    shutil.rmtree(icon_path)
                    removed.append(f"Icons: {theme_name} (preset)")
                    _printer.info(f"Removed from preset: {icon_path}", backend="baker")
                
                # Check Cursors
                cursor_path = os.path.join(themes_dir, 'cursors', theme_name)
                if os.path.exists(cursor_path):
                    shutil.rmtree(cursor_path)
                    removed.append(f"Cursors: {theme_name} (preset)")
                    _printer.info(f"Removed from preset: {cursor_path}", backend="baker")
        
        return removed
    
    def check_color_conflict(self, ws_num, hex_color):
        """
        Check if the selected hex color is already used by another workspace.
        
        Args:
            ws_num: The workspace number being checked (1-based)
            hex_color: The hex color to check (with #)
        
        Returns:
            tuple: (has_conflict, conflicting_workspaces)
        """
        conflicting = []
        hex_lower = hex_color.lower()
        
        for ws in self.workspaces:
            if ws['num'] == ws_num:
                continue  # Skip current workspace
            
            ws_color = ws.get('color', '').lower()
            if ws_color == hex_lower:
                conflicting.append(ws['num'])
        
        return len(conflicting) > 0, conflicting
    
    def _update_ini_color_direct(self, ini_path, ws_num, new_color):
        """Update color in a specific INI file directly."""
        if not os.path.exists(ini_path):
            _printer.error(f"INI file not found: {ini_path}", backend="baker")
            return False
        
        config = configparser.ConfigParser()
        config.read(ini_path)
        
        section = f'ws{ws_num}'
        if not config.has_section(section):
            config.add_section(section)
        
        config.set(section, 'icon_color', new_color)
        
        if config.has_option(section, 'color_variable'):
            clean_hex = new_color.lstrip('#')
            config.set(section, 'color_variable', f'ws{ws_num}_color')
        
        with open(ini_path, 'w') as f:
            config.write(f)
        
        _printer.info(f"Updated INI: {ini_path} ws{ws_num}.icon_color = {new_color}", backend="baker")
        return True
    
    def _update_ini_themes_direct(self, ini_path, ws_num, hex_color, gtk_preset, icon_preset, cursor_preset):
        """Update theme fields in a specific INI file directly."""
        if not os.path.exists(ini_path):
            _printer.error(f"INI file not found: {ini_path}", backend="baker")
            return None
        
        config = configparser.ConfigParser()
        config.read(ini_path)
        
        section = f'ws{ws_num}'
        if not config.has_section(section):
            config.add_section(section)
        
        clean_hex = hex_color.lstrip('#')
        
        new_gtk_theme = f"awp-gtk-{gtk_preset}-{clean_hex}"
        new_icon_theme = f"awp-icons-{icon_preset}-{clean_hex}"
        new_cursor_theme = f"awp-cursor-{cursor_preset}-{clean_hex}"
        
        config.set(section, 'gtk_theme', new_gtk_theme)
        config.set(section, 'icon_theme', new_icon_theme)
        config.set(section, 'cursor_theme', new_cursor_theme)
        config.set(section, 'wm_theme', new_gtk_theme)
        
        with open(ini_path, 'w') as f:
            config.write(f)
        
        _printer.info(f"Updated INI themes in {ini_path} for WS{ws_num}:", backend="baker")
        _printer.info(f"  gtk_theme = {new_gtk_theme}", backend="baker")
        _printer.info(f"  icon_theme = {new_icon_theme}", backend="baker")
        _printer.info(f"  cursor_theme = {new_cursor_theme}", backend="baker")
        _printer.info(f"  wm_theme = {new_gtk_theme}", backend="baker")
        
        return {
            'gtk_theme': new_gtk_theme,
            'icon_theme': new_icon_theme,
            'cursor_theme': new_cursor_theme,
            'wm_theme': new_gtk_theme
        }
    
    def _copy_to_preset(self, icon_path, ws_num):
        """Copy icon to preset folder as ws{N}.png."""
        if not icon_path or not os.path.exists(icon_path):
            return False
        
        selected_preset = self.preset_combo.currentData()
        preset_path = os.path.join(self.presets_dir, selected_preset)
        
        os.makedirs(preset_path, exist_ok=True)
        
        target_path = os.path.join(preset_path, f"ws{ws_num}.png")
        
        try:
            shutil.copy2(icon_path, target_path)
            _printer.info(f"Copied to preset: {target_path}", backend="baker")
            return True
        except Exception as e:
            _printer.error(f"Failed to copy to preset: {e}", backend="baker")
            return False
    
