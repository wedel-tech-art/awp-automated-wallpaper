    def generate_icon_theme_preview(self, hex_color, preset_name='mint', size=60):
        """Generate a preview of an icon theme's folder.svg."""
        if not hex_color or not preset_name:
            return None
        
        if not shutil.which('rsvg-convert'):
            return None
        
        # Get the preset config
        preset_config = ICON_PRESETS.get(preset_name, {})
        if not preset_config:
            return None
        
        # Get the source SVG from template-icon-presets
        template_path = preset_config.get('path', f'template-icon-presets/{preset_name}')
        svg_path = os.path.expanduser(f"~/awp/{template_path}/folder.svg")
        if not os.path.exists(svg_path):
            return None
        
        # Read the SVG
        with open(svg_path, 'r') as f:
            svg_content = f.read()
        
        # Build color replacements
        clean_hex = hex_color.lstrip('#')
        r, g, b = int(clean_hex[0:2], 16), int(clean_hex[2:4], 16), int(clean_hex[4:6], 16)
        new_rgb = f"{r}, {g}, {b}"
        
        replacements = _build_icon_replacements(preset_config, clean_hex, new_rgb)
        
        # Apply replacements
        for old, new in replacements:
            svg_content = svg_content.replace(old, new)
        
        # Render with rsvg-convert (larger for quality)
        temp_dir = f"/dev/shm/awp_preview_{os.getpid()}"
        os.makedirs(temp_dir, exist_ok=True)
        
        temp_svg = os.path.join(temp_dir, 'preview.svg')
        temp_png = os.path.join(temp_dir, 'preview.png')
        trimmed_png = os.path.join(temp_dir, 'trimmed.png')
        
        try:
            with open(temp_svg, 'w') as f:
                f.write(svg_content)
            
            # Generate at larger size for quality
            render_size = size * 3
            subprocess.run([
                'rsvg-convert',
                '-w', str(render_size),
                '-h', str(render_size),
                '-o', temp_png,
                temp_svg
            ], check=True, capture_output=True, timeout=2)
            
            if not os.path.exists(temp_png):
                shutil.rmtree(temp_dir, ignore_errors=True)
                return None
            
            # ============================================================
            # TRIM TRANSPARENT BORDERS AND CENTER
            # ============================================================
            # Check if ImageMagick is available
            if shutil.which('convert'):
                # Trim transparent borders
                subprocess.run([
                    'convert', temp_png,
                    '-trim',  # Remove transparent borders
                    '-background', 'none',
                    '-gravity', 'center',
                    '-extent', f'{render_size}x{render_size}',  # Center in a square
                    trimmed_png
                ], check=True, capture_output=True, timeout=2)
                
                # Resize to final size
                subprocess.run([
                    'convert', trimmed_png,
                    '-resize', f'{size}x{size}',
                    '-background', 'none',
                    '-gravity', 'center',
                    '-extent', f'{size}x{size}',
                    temp_png  # Overwrite with trimmed version
                ], check=True, capture_output=True, timeout=2)
            
            # Load the final image
            from PyQt6.QtGui import QPixmap
            pix = QPixmap(temp_png)
            shutil.rmtree(temp_dir, ignore_errors=True)
            return pix
            
        except Exception as e:
            shutil.rmtree(temp_dir, ignore_errors=True)
            return None
        
        return None
    
