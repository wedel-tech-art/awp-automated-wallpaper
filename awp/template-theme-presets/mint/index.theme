[Desktop Entry]
Type=X-GNOME-Metatheme
Name=Mint-Y-Dark-Aqua
Comment=AWP Hybrid Engine • Mint-Y-Dark-Aqua Transformed SVG (GTK2/3/4) Controls
Encoding=UTF-8

[X-GNOME-Metatheme]
GtkTheme=Mint-Y-Dark-Aqua
MetacityTheme=Mint-Y
IconTheme=Adwaita
CursorTheme=Bibata-Modern-Classic
ButtonLayout=:minimize,maximize,close
